class PB_DTech : PB_Ammo replaces demonpickup
{
	int ownAP;
	
	Default
	{
		Scale 0.15;
		Tag "$PB_DTECH_TAG";
		Inventory.Amount 10;
		Inventory.MaxAmount 300;
		Inventory.PickupSound "demonsoulpickup";
		Ammo.BackpackAmount 60;
		Ammo.BackpackMaxAmount 666;
		PB_Ammo.ammotype "dtech";
		PB_Ammo.HUDGraphics "BARBACZ1", "BARBACZ2", "BARBACZ3", "BARBACZ4", "ABAR7", "AMMOIC7", "PB_DTech";
		+FLOATBOB
		floatbobstrength .4;
		+INVENTORY.ALWAYSPICKUP
	}
	
	override bool TryPickup (in out Actor other) {
		if(super.TryPickup(other)) {
			ownAP = clamp(500 - other.CountInv("BasicArmor"), 0, 2);
			other.GiveInventory("PB_DemonAPBonus",1);
			return true;
		}
		return false;
	}
	
	override string PickupMessage() {
		return string.format(StringTable.Localize("$PB_DTECH_PICKUP"), res, ownAP);
	}
}

class PB_DTechLarge : PB_DTech replaces demonpickup2
{
	int ownHP;
	
	
	Default
	{
		Scale 0.25;
		Inventory.Amount 20;
	}
	
	override bool TryPickup (in out Actor other) {
		if(super.TryPickup(other)) {
			ownHP = other.health;
			other.GiveBody(2, 500);
			return true;
		}
		return false;
	}
	
	override string PickupMessage()
	{
		string msg = StringTable.Localize("$PB_DTECH_PICKUP_LARGE");
		if(ownHP < 25) msg = StringTable.Localize("$PB_DTECH_PICKUP_LARGE_LOW");
		return string.format(msg, res, clamp(500 - ownHP, 0, 2), ownAP);
	}
}

class PB_PermaDTech : PB_DTech
{
	Default
	{
		//$Title Demonic Energy
		//$Category Project Brutality/Ammunition
		//$Sprite DB61A0
		PB_Ammo.ammotype "permadtech";
	}
}

class PB_PermaDTechLarge : PB_DTechLarge
{
	Default
	{
		//$Title Large Demonic Energy
		//$Category Project Brutality/Ammunition
		//$Sprite DB61A0
		PB_Ammo.ammotype "permadtech";
	}
}

// Leech Grenade
Class PB_LeechPickup : PB_Ammo 
{
	Default
	{
		//$Title Leech
		//$Category Project Brutality/Weapons/Equipment
		//$Sprite FLSPA0
		Scale 0.35;
		Tag "$PB_LEECH_TAG";
		Inventory.PickupSound "SiphonGrowl";
		PB_Ammo.AmmoType "leechnade";
		Inventory.Amount 1;
		Ammo.BackpackAmount 0;
	}
	
	override string PickupMessage()
	{
		return "$PB_LEECH_PICKUP";
	}
	
	override void AttachToOwner(actor other)
	{
		if(amount > 0)
		{
			other.GiveInventory("PB_LeechToken",1);
			other.GiveInventory("PB_DTech",20);
			Super.AttachToOwner(other);
		}
		else
		{
			Destroy();
		}
	}
}

class PB_LeechToken : PB_EquipToken {}