class PB_BarrelToken : Inventory {
	Default {
		Inventory.MaxAmount 1;
	}

	enum barrelTypes {
		TYPE_EXPLOSIVE,
		TYPE_BURNING,
		TYPE_FROZEN
	}
	
	int barrelType;
	bool bloodstained, holes, cut, dented, drained;
}

class BarrelFire : Actor {
	Default {
		RenderStyle "Add";
		Scale 0.25;
		+NOINTERACTION
		+BRIGHT
	}
	States {
	Spawn:
		X053 ABCDEFGHIJKLMNOPQRSTU 1 NoDelay A_AttachLightDef('FlamethrowerLight', 'BarrelFire');
		Stop;
	}
}

class PB_BarrelFire : Actor {
	Default {
		Radius 0;
		Height 0;
		Scale 0.5;
		RenderStyle "Add";
		+NOINTERACTION
		+BRIGHT
	}
	
	override void Tick() {
		let barrel = PB_BarrelBase(master);
		if(barrel && barrel.barrelType == PB_BarrelBase.TYPE_BURNING) {
			SetOrigin((barrel.pos.xy, barrel.pos.z + PB_BarrelBase.FLAME_OFFSET), true);
		}
		else Destroy();
		super.Tick();
	}
	
	States {
	Spawn:
		FLME ABCDEFGHIJKLMN 1;
		Loop;
	}
}

class BarrelTopFire2 : PB_BarrelFire {}
class PB_BarrelSparks : Actor {
	Default {
		Radius 0;
		Height 0;
		RenderStyle "Add";
		+NOINTERACTION
		+BRIGHT
	}
	
	override void Tick() {
		let barrel = PB_BarrelBase(master);
		if(barrel && barrel.barrelType == PB_BarrelBase.TYPE_BURNING) {
			SetOrigin((barrel.pos.xy, barrel.pos.z + PB_BarrelBase.FLAME_OFFSET), true);
		}
		else Destroy();
		super.Tick();
	}
	
	States {
	Spawn:
        SPFN ABCDEFGHIJKLMNOPQRSTUVWXYZ 1;
		SPFM ABCDEFG 1;
		Loop;
	}
}