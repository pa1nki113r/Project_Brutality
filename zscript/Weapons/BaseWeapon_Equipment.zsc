class PB_RevLauncherFireCount : Inventory{Default{Inventory.MaxAmount 3;}}
extend class PB_WeaponBase
{
	States
	{
	UseEquipment:
		TNT1 A 0 {
			if(FindInventory("CantDoAction") || health < 1) return;
			A_ClearOverlays(-80,80);
			A_TakeInventory("RailgunInfrared", 1);
			A_StopSound(CHAN_WEAPON);
			A_StopSound(CHAN_VOICE);
			A_StopSound(CHAN_6);
			A_StopSound(CHAN_7);
			A_TakeInventory("UseEquipment", 1);
			let equip = PlayerPawnBase(self).selectedEquipment;
			if(!equip) return;
			bool success = equip.UseEquipment();
			if(success && !equip.handless) {
				PB_SetUsingEquipment(true);
				PB_SetReloading(false);
				A_SetInventory("Zoomed", 0);
				A_ZoomFactor(1.0);
				A_Overlay(PSP_WEAPON, "UsingEquipment");
				A_OverlayOffset(); //no args resets to default
			}
		}
		Stop;
	UsingEquipment:
		TNT1 A 1;
		Wait;
	SwitchEquipment:
		TNT1 A 0 {
			A_TakeInventory("ToggleEquipment", 1);
			let equip = PlayerPawnBase(self).selectedEquipment;
			if(!equip) return;
			A_Print(equip.selectString);
			A_StartSound(equip.selectSound, 3);
		}
		goto Equipment_Toggle_Handler_Overlay;
	}
}
