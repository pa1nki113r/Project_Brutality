Class PB_CyberDSpawner_DW : PB_MonsterSpawner
{
	default
	{
		PBRandomSpawner.SpawnOverride "pb_cyberdemon_override";
		dropitem "PB_Cyberdemon1",255,1;
		dropitem "PB_Annihilator",255,1;
	}
	
	override bool HandleSpawnExceptions(name toSpawn)
	{
		if(toSpawn == "PB_Annihilator" && pb_cyberdemon_filter & DisablePB_Annihilator)
			return false;
