ACTOR HandGrenadeAnother: PB_ThrownGrenade
{
	+BOUNCEONFLOORS
	+BOUNCEONWALLS
	+BOUNCEONCEILINGS
	-BOUNCEONACTORS
	-ALLOWBOUNCEONACTORS
	-EXTREMEDEATH
	+NOEXTREMEDEATH
	BounceFactor 0.600
	BounceSound "grenade/bounce"
}

ACTOR EnemyThrownGrenade : HandGrenadeAnother
{
	+ALLOWBOUNCEONACTORS
	+BOUNCEONACTORS
	+NOEXTREMEDEATH
	+DONTHURTSPECIES
	-UseBounceState
	Species "Zombieman"
	+MTHRUSPECIES
	+THRUSPECIES
	Damage 0
	Gravity 1.0
	Speed 16

	PB_ThrownGrenade.GrenadeExplosionParams 45, 120
	PB_ThrownGrenade.FlareActorName "PB_GrenadeWarningFlare_Red"
}

ACTOR ThrownGrenade15 : HandGrenadeAnother
{
	Speed 15
}

ACTOR EnemyThrownStunGrenade : PB_ThrownStunGrenade
{
	+ALLOWBOUNCEONACTORS
	+BOUNCEONACTORS
	+NOEXTREMEDEATH
	+DONTHURTSPECIES
	-UseBounceState
	Species "Zombieman"
	+MTHRUSPECIES
	+THRUSPECIES
	Damage 0
	Gravity 1.0
	Speed 16

	PB_ThrownGrenade.FlareActorName "PB_GrenadeWarningFlare_Yellow"
	PB_ThrownStunGrenade.ExplosionActor "EnemyStunGrenadeExplosion"
}

ACTOR DoomerRevenantSeeker2 : RevenantSeeker
{
	Damage (144)
	Speed 35
	Species "Marines"
	+MTHRUSPECIES
	+THRUSPECIES
	-THRUGHOST
	+DONTHURTSPECIES
	+Screenseeker
	States
	{
		Spawn:
			FA1B A 0 NoDelay {
				A_StartSound("HMLF1",CHAN_AUTO);
				A_StartSound("weapons/rocketloop",CHAN_6,CHANF_LOOP);
			}
			TNT1 A 0 A_SpawnItemEx("RevenantProjectileTrails", -20, 0, 0, 0, 0, 0, 0, 128)
			FA1B AB 1 BRIGHT A_SpawnItemEx("RedFlareSmall")
			TNT1 A 0 A_SpawnItemEx("RevenantProjectileTrails", -20, 0, 0, 0, 0, 0, 0, 128)
			FA1B AB 1 BRIGHT A_SpawnItemEx("RedFlareSmall")
			TNT1 A 0 A_SpawnItemEx("RevenantProjectileTrails", -20, 0, 0, 0, 0, 0, 0, 128)
			FA1B AB 1 BRIGHT A_SpawnItemEx("RedFlareSmall")
			TNT1 A 0 A_SpawnItemEx("RevenantProjectileTrails", -20, 0, 0, 0, 0, 0, 0, 128)
			FA1B AB 1 BRIGHT A_SpawnItemEx("RedFlareSmall")
			TNT1 A 0 A_StartSound("weapons/rocket/rocketignite", CHAN_AUTO, CHANF_OVERLAP, 0.25)
		Fly:
			TNT1 A 0 {
				A_SpawnItemEx("RevenantProjectileTrails", -20, 0, 0, 0, 0, 0, 0, 128);
				A_SeekerMissile (20,30,SMF_PRECISE|SMF_LOOK);
			}
			FA1B AB 1 BRIGHT Light("PB_ROCKET") {
				A_Weave(2,2,1,1);
				A_SpawnItemEx("RedFlareSmall");
			}
			Loop
	}
}

ACTOR DoomerRevenantSeeker3 : DoomerRevenantSeeker2
{
}
