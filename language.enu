//Tips
PB_BRACE_TIP_1 = "In Project Brutality, you can stand still next to a wall or crouch to brace your weapon.";
PB_BRACE_TIP_2 = "Bracing will reduce the recoil of your weapon by 67%. Crouching will also improve your weapon's accuracy by 50%.";
PB_BRACE_TIP_3 = "You can know if you are braced by looking for the blue bracing indicator on the bottom right of your HUD.";

PB_DASH_TIP_1 = "When dashing, you can kick to perform a dropkick, or jump while grounded to perform a dash jump.";
PB_DASH_TIP_2 = "A dropkick will deal massive damage, and instantly kill lesser enemies.";
PB_DASH_TIP_3 = "They are also very useful to kick away or stun bigger enemies.";
PB_DASH_TIP_4 = "Dash jumping consumes an additional charge to leap forward at high speed.";

PB_EXECUTION_TIP_1 = "When an enemy's health is low enough, they become vulnerable to executions.";
PB_EXECUTION_TIP_2 = "You can execute an enemy by pressing %s while the red frame is being displayed.";
PB_EXECUTION_TIP_3 = "Executing enemies will grant you a bit of health, depending on the amount you currently have.";

PB_ARMOR_TIP_1 = "You have attempted to pick up armor you don't need.";
PB_ARMOR_TIP_2 = "When your armor\'s effectiveness is lower than that of the new armor, it will be picked up automatically.";
PB_ARMOR_TIP_3 = "Else, you can press the USE key to pick it up manually.";

PB_BERSERK_TIP_1 = "Berserk allows enemies to be executed at higher health than normal, and allows weaker enemies to be executed at full health.";
PB_BERSERK_TIP_2 = "It also allows you to automatically execute enemies with your fists. You can press %s to swap modes.";
PB_RADSUIT_TIP = "The radiation suit reduces electric damage by 1/4 and provides complete protection against fire, ice, and acid damage.";

PB_REVOLVER_TIP = "Quickly pressing fire instead of holding it fans the revolver for higher rpm.";
PB_CARBINE_TIP = "The carbine's hyperburst delays recoil until all three shots have fired.";
PB_MG42_TIP = "The MG 42's barrel heats up when firing. The hotter it gets, the worse its accuracy becomes.";
PB_FLAMETHROWER_TIP = "Nukage mode: primary fire drenches enemies, making them explode on death. Altfire launches globs of nukage that explode when hit.";
PB_BFG_TIP = "Press %s to detonate black holes in midair.";
PB_UNCHARGE_TIP = "While charging a weapon, press %s to cancel it..";
PB_RAILGUN_TIP = "While scoped in, press %s to toggle night vision.";

PB_UNMAKER_TIP_1 = "The Unmaker harvests the souls of killed enemies.";
PB_UNMAKER_TIP_2 = "When your soul meter is at least half-full, you can press %s to activate overcharge.";
PB_UNMAKER_TIP_3 = "Overcharging will empower its attacks, but constantly consumes souls until you run out.";

PB_BARREL_TIP_1 = "Fire damage will set barrels on fire. Flaming barrels have lower radius and damage, but spread damaging flame.";
PB_BARREL_TIP_2 = "Ice damage will freeze barrels. Frozen barrels have higher damage and range, do not hurt the player, and spread ice crystals.";
PB_BARREL_TIP_3 = "Plasma and electric damage will cause barrel explosions to be electrified, stunning nearby enemies.";

