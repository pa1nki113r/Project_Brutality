Actor ChexLightningModeProjectile
{
  Height 0
  Radius 0
  Mass 0
  +Missile
  +NoBlockMap
  +NOGRAVITY
  +FORCEXYBILLBOARD
  BounceFactor 0.2
  Damage 3
  RenderStyle Add
  DamageType "Saw"
  Scale 0.04
  //Speed 2
  Speed 50
  States
  {
  Spawn:
	CPSQ BBBBBBBBBB 2 Bright A_CustomMissile ("RedFlareSmall", 0, 0, 0, 2, 1)
	Stop
Death:
	TNT1 A 0
	Stop
  }
}

ACTOR PB_ChexRifle : PB_Weapon 
{
	PB_WeaponBase.LeftHandMelee 1
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 40
	Weapon.AmmoGive2 0
	Scale 0.50
	Weapon.AmmoType1 "PB_Cell"
	Weapon.AmmoType2 "ChexRifleAmmo"
	Inventory.PickupMessage "Zorch Rifle (Slot 4)"
	Inventory.PickupSound "weapons/chexrifle/in"
	Obituary "%k got a Chex-weapon somehow and killed %o"
	AttackSound "None"
	Tag "Zorch Rifle"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	+WEAPON.AMMO_OPTIONAL
	+WEAPON.CHEATNOTWEAPON
	+DONTGIB
	States
	{
	Spawn:
		CRRS A -1 
		Loop
	Select:
		TNT1 A 0 PB_WeaponRaise("PLSDRAW")
		TNT1 A 0 PB_RespectIfNeeded
		TNT1 A 0 PB_HandleCrosshair(10)
		TNT1 A 0 A_Raise
		Wait
	WeaponRespect:
		TNT1 A 0 A_SetCrosshair(-1)
		CRR1 ABCDEFGHIKLMNOPQRSTVXYZ 1 A_DoPBWeaponAction
		CRR2 ABCD 1 A_DoPBWeaponAction
		TNT1 A 0 { 
		A_SpawnItem("PinkIonFlare",30,0);
		A_SpawnItemEx("ChexParticleS", 10, 10, 0, 0, 0, 0, 0, 128);
		A_SpawnItem("PurplePlasmaFlare",10,0);
		A_SpawnItem("PinkIonFlare",40,0);
		A_SpawnItemEx("ChexParticleS", 20, -10, 0, 0, 0, 0, 0, 128);
		A_SpawnItem("PurplePlasmaFlare",10,-30);
		A_SpawnItem("ChexParticleSpawn",50,0);
		A_SpawnItemEx("ChexParticleS", 30, 10, 0, 0, 0, 0, 0, 128);
		A_SpawnItem("ChexParticleSpawn",30,0);
		}
		TNT1 A 0 A_PlaySound("PLSOFF")
		CRR2 EFGHIKLMNOPQRSTVXYZ 1 {A_SetRoll (roll+1.5); return A_DoPBWeaponAction;}
		CRR3 ABCD 1 {A_SetRoll (roll-1.5); return A_DoPBWeaponAction;}
		TNT1 A 0 A_PlaySound ("weapons/chexrifle/out", 3)
		CRR3 EFGHIKLMNOPQ 1 {A_SetRoll (roll-1.5); return A_DoPBWeaponAction;}
		TNT1 A 0 A_PlaySound ("weapons/chexrifle/in", 6)
		CRR3 RSTVXYZ 1 {A_SetRoll (roll+1.5); return A_DoPBWeaponAction;}
		CRR4 ABCDEFG 1 {A_SetRoll (roll+1.5); return A_DoPBWeaponAction;}
		CRR4 HIKLMN 1 {A_SetRoll (roll-1.5); return A_DoPBWeaponAction;}
		TNT1 A 0 A_SetRoll(0)
		Goto RealReady
	Ready:
	SelectAnimation:
		CHRS D 1
		CXSU A 0 A_JumpIf(PB_GetMagUnloaded,2)
		CHRS A 0
		"####" CBA 1
		Goto RealReady
	RealReady:
	Ready3:
		TNT1 A 0 PB_HandleCrosshair(10)
		TNT1 A 0 A_JumpIf(PB_GetMagUnloaded,"Unloaded")
		CHRE EEEEEEAABBCCCDDDDCCCBBAAEEEEEE 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		Loop
	Unloaded:
		CHRU A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
		loop
		
	/*
	AltFire:
		TNT1 A 0 A_JumpIfInventory("ChexRifleAmmo", 1, 2)
		Goto Reload
		TNT1 AAA 0
		CXXA ABCD 1
		TNT1 A 0 A_PlaySound("PLSC_1", 1)
		CXXA ABCD 1
		TNT1 A 0 A_PlaySound("PLSC_2", 1)
		CXXA ABCD 1 
		TNT1 A 0 A_PlaySound("PLSC_3", 1)
		CXXA ABCD 1
		TNT1 A 0 A_PlaySound("PLSC_4", 1)
	AltHold:
		TNT1 A 0 A_JumpIfInventory("ChexRifleAmmo", 1, 2)
		Goto Reload
		TNT1 AAA 0
		TNT1 A 0 A_PlaySound("PAILGF2",3)
		TNT1 A 0 A_TakeInventory("ChexRifleAmmo", 1)
		TNT1 A 0 A_Recoil(1)
		TNT1 A 0 A_SetPitch(pitch-3)
		CXAF ABCD 1 Bright {
			A_FireCustomMissile ("ChexLightningModeProjectile", 0, 0, random(-10, 10), random(20, -20));
			A_FireCustomMissile ("ChexLightningModeProjectile", 0, 0, random(-20, 20), random(-1, 14));
			A_FireCustomMissile ("ChexLightningModeProjectile", 0, 0, random(-6, 16), random(6, 19));
		}
		TNT1 A 0 PB_ReFire
	*/
	Fire:
		TNT1 A 0 PB_JumpIfNoAmmo("Reload",1,false)
		CHRE F 1 BRIGHT
		{
			PB_HandleCrosshair(10);
			A_PlaySound("weapons/chexrifle/fire",3);
			A_AlertMonsters;
			A_ZoomFactor(.985);
			A_RailAttack(0, -5, 0, none,none, RGF_SILENT|RGF_NOPIERCING|RGF_EXPLICITANGLE, 0,"ChexProjectile",0,0,2000,0,1,1.0,"Tracer_Trail_ChexRed",-6,0,0);
			A_FireCustomMissile("ShakeYourAssMinor", 0, 0, 0, 0);
			A_SpawnItem("PinkIonFlare",14,30,0,0);
			A_ZoomFactor(.970);
			A_SpawnItem("ChexParticleSpawn",30,0);
			PB_LowAmmoSoundWarning("hdmr");
			PB_TakeAmmo("ChexRifleAmmo",1,0);
		}
		CHRE G 1 BRIGHT A_ZoomFactor(.965)
		CHRE H 1 BRIGHT A_ZoomFactor(.985)
		CHRE I 1 BRIGHT A_ZoomFactor(1.0)
		TNT1 A 0 PB_ReFire
		Goto RealReady
	Deselect:
		CXSU A 0 A_JumpIf(PB_GetMagUnloaded,2)
		CHRS A 0
		"####" ABC 1
		CHRS D 1
	RealDeselect:
		TNT1 A 0 A_Lower
		Wait
	Reload:
		TNT1 A 0 PB_CheckReload("ReloadAnimationIfUnloaded","","","Ready3","Ready3",42,1)
		CXR1 ABC 1 A_SetRoll(roll-1.2, SPF_INTERPOLATE)
		CXRE A 0 A_JumpIf(CountInv("ChexRifleAmmo") < 1, 2)
		CXR1 A 0
		"####" DEF 1 A_SetRoll(roll-1.2, SPF_INTERPOLATE)
		"####" GHIJ 1 A_SetRoll(roll+.8)
		"####" KLM 1 A_SetRoll(roll+0.4)
		"####" NOP 1
		"####" Q 1
		"####" R 1 {
			A_PlaySound ("weapons/chexrifle/out", 3);
			PB_SetMagUnloaded(true);
		}
		CXR1 STUVWX 1 A_SetRoll (roll+1.45, SPF_INTERPOLATE)
	ContinueReloadFromUnloaded:
		CXR1 YZ 1
		CXR2 A 1
		CXR2 BCDEFG 1
		TNT1 A 0 A_PlaySound ("weapons/chexrifle/in", 6)
		CXR2 HIJKLM  1 A_SetRoll (roll-01.45, SPF_INTERPOLATE)
		CXR2 NOPQRST 1 A_SETROLL(ROLL-.56, SPF_INTERPOLATE)
		TNT1 A 0 {
			A_PlaySound ("weapons/riflemagslap", 3);
			PB_AmmoIntoMag("ChexRifleAmmo","PB_Cell",42,1);
			PB_SetMagEmpty(false);
			PB_SetMagUnloaded(false);
			PB_SetChamberEmpty(false);
		}
		CXR2 TUVWXYZ 1 A_SETROLL(ROLL-0.4, SPF_INTERPOLATE)
		CXR3 ABCDEFG 1 A_SetRoll (roll+0.4, SPF_INTERPOLATE)
		CXR3 HIJK 1
		TNT1 A 0 {
			A_SetRoll (0);
			PB_SetReloading(false);
		}
		Goto RealReady
	WeaponSpecial:
		TNT1 A 0 A_SetInventory ("GoWeaponSpecialAbility",0)
		Goto RealReady
	ReloadAnimationIfUnloaded:
		CHRU ABC 1 A_SetRoll(roll-1.8, SPF_INTERPOLATE)
		CHRU DEF 1 A_SetRoll(roll-1.8, SPF_INTERPOLATE)
		CHRU GHIJ 1 A_SetRoll(roll+.4)
		CXR1 WX 1 A_SetRoll (roll+1.0, SPF_INTERPOLATE)
		Goto ContinueReloadFromUnloaded
		
	Unload:
		TNT1 A 0 A_SetInventory ("Unloading",0)
		TNT1 A 0 A_JumpIfInventory("ChexRifleAmmo", 1, "UnloadAnimation")
		Goto RealReady
	UnloadAnimation:
		CXR1 ABC 1 A_SetRoll(roll-1.2, SPF_INTERPOLATE)
		CXRE A 0 A_JumpIf(CountInv("ChexRifleAmmo") < 1, 2)
		CXR1 A 0
		CXR1 DEF 1 A_SetRoll(roll-1.2, SPF_INTERPOLATE)
		CXR1 GHIJ 1 A_SetRoll(roll+.8)
		CXR1 KLM 1 A_SetRoll(roll+0.4)
		CXR1 NOP 1
		CXR1 Q 1
		CXR1 R 1 {
			A_PlaySound ("weapons/chexrifle/out", 3);
			PB_UnloadMag("ChexRifleAmmo","PB_Cell",1);
			PB_SetMagUnloaded(true);
		}
		CXR1 STUVWX 1 A_SetRoll (roll+1.45, SPF_INTERPOLATE)
		CXR1 Y 10
		CHRU JIHGFEDC 1
		TNT1 A 0 A_SetRoll(0)
		Goto RealReady
		
	FlashPunching:
	FlashKicking:
		TNT1 A 0 A_WeaponOffset(0,32)
		TNT1 A 0 A_JumpIf(PB_GetMagUnloaded, "FlashKickingUnloaded")
		CXR1 BCDEFG 1
		CXR1 H 2
		CXR1 GFEDCB 1
		Goto Ready3
	FlashKickingUnloaded:
		CHRU DEFGHI 1
		CHRU J 2
		CHRU IHGFED 1
		Goto Ready3
		
	FlashAirKicking:
		TNT1 A 0 A_WeaponOffset(0,32)
		CRR4 N 1
		CRR4 M 1 
		CRR4 L 1 
		CRR4 K 1
		CRR4 J 1 
		CRR4 I 2 
		CRR4 H 5 
		CRR4 I 2 
		CRR4 J 1 
		CRR4 K 1 
		CRR4 L 1 
		CRR4 M 1 
		CRR4 N 1 
		Goto Ready3
		
	FlashSlideKicking:
		TNT1 A 0 A_WeaponOffset(0,32)
		CRR4 ML 2
		CRR4 JIIIIIII 2 A_WeaponOffset(random(-2,2),random(32,34)) 
		Goto Ready3
		
	FlashSlideKickingStop:
		TNT1 A 0 A_WeaponOffset(0,32)
		CRR4 I 2
		CRR4 JKLM 1 
		CRR4 N 1
		Goto Ready3
}
}
		