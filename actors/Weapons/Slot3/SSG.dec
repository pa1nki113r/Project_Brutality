// --------------------------------------------------------------------------
//
// Sawed-Off (SSG)
//
// --------------------------------------------------------------------------

Actor PB_SSGFireAnimation1: Inventory
{
	Inventory.maxamount 1
}

Actor PB_SSGFireAnimation2: Inventory
{
	Inventory.maxamount 1
}

ACTOR LeftSSGAmmo : PB_WeaponAmmo 
{
	Inventory.MaxAmount 2
	+INVENTORY.IGNORESKILL
	Inventory.Icon "SGN3A0"
}


ACTOR SSGAmmoCounter: PB_WeaponAmmo
{
	Inventory.MaxAmount 2
	+INVENTORY.IGNORESKILL
	Inventory.Icon "SGN3A0"
}

ACTOR SSGSpentR : Inventory {Inventory.MaxAmount 2}
ACTOR SSGSpentL : Inventory {Inventory.MaxAmount 2}

Actor SSGBarrelHeat: Inventory
{Inventory.maxamount 200}

Actor SSGBarrelHeat2: Inventory
{Inventory.maxamount 200}


ACTOR PB_SSG : PB_weapon //Replaces SuperShotgun
{
	//$Title Double Barreled Shotgun
	//$Category Project Brutality - Weapons
	//$Sprite SGN3A0
	Game Doom
	Weapon.Kickback 50
	Weapon.SelectionOrder 400
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 8
	Weapon.AmmoGive2 0
	weapon.slotnumber 3
	Weapon.AmmoType "PB_Shell"
	Weapon.AmmoType2 "SSGAmmoCounter"
	weapon.slotpriority 0.25
	PB_WeaponBase.AmmoTypeLeft "LeftSSGAmmo"
	+FLOORCLIP
	+DONTGIB
	+WEAPON.NOAUTOAIM
	Tag "$PB_SSG_TAG"
	+WEAPON.NOAUTOFIRE
	Inventory.MaxAmount 2
	Inventory.PickupMessage "$PB_SSG_PICKUP"
	Obituary "%o was splattered by %k's SSG"
	Inventory.PickupSound "CLIPINQS"
	Scale 0.5
	Inventory.AltHUDIcon "SGN3A0"
	FloatBobStrength 0.5
	PB_WeaponBase.Upgrade "PB_QuadSG"
	States
	{
		
	Steady:
		TNT1 A 1
		Goto Ready

	Spawn:
		VGN2 A 0 NoDelay
		SGN3 A 10 A_PbvpFramework("VGN2")
		"####" "#" 0 A_PbvpInterpolate()
		LOOP
		
	Deselect:
		TNT1 A 0 A_JumpIfInventory ("GrabbedBarrel", 1, "PlaceBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedFlameBarrel", 1, "PlaceFlameBarrel")
		TNT1 A 0 A_JumpIfInventory ("GrabbedIceBarrel", 1, "PlaceIceBarrel")
		TNT1 A 0 {
			A_ClearOverlays(10,11);
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			A_SetInventory("PB_LockScreenTilt",0);
		}
		TNT1 A 0 A_SetInventory("Unloading",0)
		TNT1 A 0 A_SetInventory("SSGSelected",0) 
		
		TNT1 A 0 //A_JumpIfInventory("PB_QuadSG",1,"DeselectUpgrade")
		TNT1 A 0 A_JumpIf(A_CheckAkimbo,"DeselectAnimationDualWield")
		SHO9 FEDC 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		Wait
	DeselectAnimationDualWield:
		P6SS DCBA 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		Wait
	//DeselectUpgrade:
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		Wait

	Select:
		TNT1 A 0 PB_WeaponRaise
		TNT1 A 0 {
			A_ClearOverlays(10,11);
			PB_HandleCrosshair(40);
		}
		TNT1 A 0 PB_SelectIfUpgrade("PB_QuadSG") //A_SelectWeapon("PB_QuadSG")
		TNT1 A 0 PB_WeapTokenSwitch("SSGSelected")
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Raise
		TNT1 AAAAAAAA 1 A_Raise
		Wait

	Ready:
		TNT1 A 0 PB_SelectIfUpgrade("PB_QuadSG") //A_SelectWeapon("PB_QuadSG")
		TNT1 A 0 A_SetInventory("HasNotPickedUpSSG",0)
		TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
		TNT1 A 0 PB_RespectIfNeeded
	WeaponRespect:
		TNT1 A 0 {
			A_SetInventory("PB_LockScreenTilt",1);
			A_PlaySoundEx("Ironsights", "Auto");
			A_SetCrosshair(-1);
			}
		SG50 EFGHIJKLMNO 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect1", "Auto")
		SG50 PQRSTUVWXYZ 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SG51 ABCDEFGHIJKLMNOPQRST 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect2", "Auto")
		SG51 UVWXYZ 1 A_DoPBWeaponAction
		SG52 ABCDEFGHIJK 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect2", "Auto")
		SG52 LMNOPQRSTUVWXYZ 1 A_DoPBWeaponAction
		SG53 ABCDE 1 A_DoPBWeaponAction
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect3", "Auto")
		SG53 FGHIJKLMNOPQRST 1 A_DoPBWeaponAction
		Goto Ready3
	SelectAnimation:
		TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "SelectAnimationDualWield")
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		SG1S DCBA 1
	Ready3:
		TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "ReadyDualWield")
		TNT1 A 0 {
			A_ClearOverlays(10,11);
			A_SetInventory("PB_LockScreenTilt",0);
			PB_HandleCrosshair(40);
			A_SetRoll(0);
			}
		TNT1 A 0 A_JumpIf(A_CheckAkimbo,"ReadyToFireDualWield")
	RealReady:
		TNT1 A 0 PB_SelectIfUpgrade("PB_QuadSG") //A_SelectWeapon("PB_QuadSG")
		SHT3 A 1 {
			PB_CoolDownBarrel(2, 0, 3);
			PB_CoolDownBarrel(-2, 0, 3);
			if (PressingFire() && CountInv("SSGAmmoCounter") > 0 ){
					return state("Fire");
			}
			return A_DoPBWeaponAction(WRF_ALLOWRELOAD,CheckUnloaded("PBSSGHasUnloaded"));
		}
		Loop
	BarrelSmoke1:
		TNT1 A 1 {
			A_FireCustomMissile("GunBarrelSmoke", 0, 0, -0.8, 0, 0, 0);
			A_FireCustomMissile("GunBarrelSmoke", 0, 0, 0.8, 0, 0, 0);
			A_Takeinventory("SSGBarrelHeat",1);
		}
	BarrelSmokeDual1:
		TNT1 A 1 {
			A_FireCustomMissile("GunBarrelSmoke", 0, 0, 2.4, 0, 0, 0);
			A_FireCustomMissile("GunBarrelSmoke", 0, 0, 4, 0, 0, 0);
			A_Takeinventory("SSGBarrelHeat",1);
		}
	BarrelSmokeDual2:
		TNT1 A 1 {
			A_FireCustomMissile("GunBarrelSmoke", 0, 0, -4, 0, 0, 0);
			A_FireCustomMissile("GunBarrelSmoke", 0, 0, -2.4, 0, 0, 0);
			A_Takeinventory("SSGBarrelHeat2",1);
		}
		Stop
	SelectAnimationDualWield:
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		P6SS ABCD 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
	ReadyDualWield:
		TNT1 A 0 PB_SelectIfUpgrade("PB_QuadSG") //A_SelectWeapon("PB_QuadSG")
		TNT1 A 0 {
			A_SetRoll(0);
			PB_HandleCrosshair(40);
			A_SetInventory("PB_LockScreenTilt",0);
			A_SetFiringRightWeapon(False);
			A_SetFiringLeftWeapon(False);
			A_TakeInventory("DualFiring",1);
			if(CountInv("LeftSSGAmmo") < CountInv("SSGAmmoCounter")){
				A_GiveInventory("DualFiring",1);
			}
// 			if(CountInv("PB_Shell")>0){
// 				if(CountInv("LeftSSGAmmo")<=0){
// 					A_GiveInventory("DualFireReload",1);
// 				}
// 				if(CountInv("SSGAmmoCounter")<=0){
// 					A_GiveInventory("DualFireReload",1);
// 				}
// 			}
			A_Overlay(10, "IdleLeft_Overlay", false);
			A_Overlay(11, "IdleRight_Overlay", false);
		}
	DualFireCheck:
		TNT1 A 0 {
			if(CountInv("PB_Shell")>0){
				if(CountInv("LeftSSGAmmo")<=0 || CountInv("SSGAmmoCounter")<=0){
					if(CountInv("LeftSSGAmmo")<=0 && CountInv("SSGAmmoCounter")<=0){
						A_SetInventory("DualFireReload",2);
					} 
					else{
						A_SetInventory("DualFireReload",1);
					}
				}
			}
			
			if(!PB_CanDualWield())
			{
				A_ClearOverlays(10,11);
				A_SetAkimbo(false);
				return state("StopDualWield");
			}
			
			if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringLeftWeapon() || ((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringRightWeapon())){ 
				Return State("FireDualBlank");
				}
				Return A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOFIRE);
			}
	ReadyToFireDualWield:
		TNT1 A 0 PB_SelectIfUpgrade("PB_QuadSG")
		TNT1 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOFIRE)
		Goto DualFireCheck
// FireDualBlank state made to prevent strange issues with dual SSGs.
	FireDualBlank:
		TNT1 A 0 A_JumpIfInventory("DualFireReload",2,"AltFireDualBlank")
		TNT1 A 12 A_DoPBWeaponAction(WRF_NOSWITCH | WRF_NOFIRE)
		Goto DualFireCheck
// State to prevent strange issues with left fire going straight to reload, only initiated from the jump state above.
	AltFireDualBlank: 
		TNT1 A 0
		Goto ReloadDualWield

	IdleLeft_Overlay:
		P6SS H 1 {
			PB_CoolDownBarrel(13, 0, 3);
			PB_CoolDownBarrel(8, 0, 3);
			if(CountInv("LeftSSGAmmo")<=0 && CountInv("SSGAmmoCounter")>0){
				A_GiveInventory("DualFiring",1);
			}
			if((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringLeftWeapon() && GetCvar("SingleDualFire") >=2){
					if(CountInv("LeftSSGAmmo") > 0){
						return state("FireLeft_Overlay");
					}
					else if(JustPressed(BT_ALTATTACK)){
						A_PlaySoundEx("weapons/empty", "Auto");
						return state("");
					}
				}
			if(CountInv("DualFiring")==0 || (CountInv("DualFiring")==0 && CountInv("SSGAmmoCounter")<=0) || GetCvar("SingleDualFire")==1){
				if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringLeftWeapon() && GetCvar("SingleDualFire") <=1){
					if(CountInv("LeftSSGAmmo") > 0){
						return state("FireLeft_Overlay");
					}
					else if(JustPressed(BT_ATTACK)){
						A_PlaySoundEx("weapons/empty", "Auto");
						return state("");
					}
				}
			}
			return state("");
		}
		Loop
	IdleRight_Overlay:
		P6SS G 1 {
			PB_CoolDownBarrel(-13, 0, 3);
			PB_CoolDownBarrel(-8, 0, 3);
			if(CountInv("LeftSSGAmmo")>0 && CountInv("SSGAmmoCounter")<=0){
				A_TakeInventory("DualFiring",1);
			}
			if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringRightWeapon() && GetCvar("SingleDualFire") == 2){
				if(CountInv("SSGAmmoCounter") > 0){
					return state("FireRight_Overlay");
				}
				else if(JustPressed(BT_ATTACK)){
					A_PlaySoundEx("weapons/empty", "Auto");
					return state("");
				}
			}
			if(CountInv("DualFiring")==1 || (CountInv("DualFiring")==1 && CountInv("LeftSSGAmmo")<=0)){
				if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringLeftWeapon() && GetCvar("SingleDualFire")==0){
					if(CountInv("SSGAmmoCounter") > 0){
						return state("FireRight_Overlay");
					}
					else if(JustPressed(BT_ATTACK)){
						A_PlaySoundEx("weapons/empty", "Auto");
						return state("");
					}
				}
			}
			if((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringRightWeapon()){
				if(CountInv("SSGAmmoCounter")>0 && GetCvar("SingleDualFire")==1){
					return state("FireRight_Overlay");
				}
				if(CountInv("SSGAmmoCounter")>0 && CountInv("LeftSSGAmmo")>0 && GetCvar("SingleDualFire")==0){
					A_Overlay(10, "FireLeft_Overlay", false);
					return state("FireRight_Overlay");
				}
				else if(JustPressed(BT_ALTATTACK)){
					A_PlaySoundEx("weapons/empty", "Auto");
					return state("");
				}
			}

			return state("");
		}
		Loop
		LeftFlash:
			P6WM CD 1 Bright A_GunFlash
			Stop
	FireLeft_Overlay:
		P6W2 A 1 BRIGHT {
			PB_IncrementHeat(10, true);
			A_Overlay(-5, "LeftFlash", true);
			A_OverlayFlags(-5,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-5,STYLE_Add);
			if(CountInv("LeftSSGAmmo") == 1) {
				A_AlertMonsters;
				//A_FireBullets(9, 6, 10, 7, "ShotgunPuff");
				PB_FireBullets("PB_10GAPellet",10,8,0,0,6);
				A_StartSound("weapons/shh2", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "shotgun");
				//A_FireCustomMissile("GunFireSmokE", 0, 0, -3, 0, 0, 0);
				//A_FireCustomMissile("GunFireSmoke", 0, 0, -5, 0, 0, 0);
				PB_GunSmoke(3,0,0); PB_MuzzleFlashEffects(3,0,0);
				PB_GunSmoke(5,0,0); PB_MuzzleFlashEffects(5,0,0);
				A_ZoomFactor(0.95);
				A_SetInventory("PB_SSGFireAnimation2",1); 
				A_SetInventory("PB_SSGFireAnimation1",0); 
				A_TakeInventory("LeftSSGAmmo", 1);
				A_GiveInventory("SSGSpentL",1);
				A_FireProjectile("ShotgunWad",random(-1,1),0,-10,-2,FPF_NOAUTOAIM,random(-1,1));
			}
			else {
				A_AlertMonsters;
				//A_FireBullets (12, 6, 20, 7, "ShotgunPuff");
				PB_FireBullets("PB_10GAPellet_LP",1,0,0,0,0);
				PB_FireBullets("PB_10GAPellet",20,8,0,0,6);
				//A_FireCustomMissile("GunFireSmokE", 0, 0, 3, 0, 0, 0);
				//A_FireCustomMissile("GunFireSmoke", 0, 0, 5, 0, 0, 0);
				PB_GunSmoke(3,0,0); PB_MuzzleFlashEffects(3,0,0);
				PB_GunSmoke(5,0,0); PB_MuzzleFlashEffects(5,0,0);
				A_StartSound("SSHFIRE", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "shotgun");
				A_ZoomFactor(0.95);
				A_SetInventory("PB_SSGFireAnimation2",1); 
				A_SetInventory("PB_SSGFireAnimation1",0); 
				PB_TakeAmmo("LeftSSGAmmo", 2, 0, 0, true);
				A_GiveInventory("SSGSpentL",2);
				A_FireProjectile("ShotgunWad",random(-1,1),0,-10,-2,FPF_NOAUTOAIM,random(-1,1));
				A_FireProjectile("ShotgunWad",random(-1,1),0,-6,-2,FPF_NOAUTOAIM,random(-1,1));
			}
		}
		P6W2 B 1 BRIGHT {
			//A_FireCustomMissile("GunFireSmokE", 0, 0, 3, 0, 0, 0);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, 5, 0, 0, 0);
			PB_GunSmoke(-3,0,0); PB_MuzzleFlashEffects(-3,0,0);
			PB_GunSmoke(-5,0,0); PB_MuzzleFlashEffects(-5,0,0);
			}
		P6W2 C 1 {
			A_ZoomFactor(0.975);
			PB_WeaponRecoil(-3.80,+2.40);
		}
		P6W2 D 1 {
			A_ZoomFactor(1.0);
			PB_WeaponRecoil(-3.80,+2.40);
		}
		P6W2 E 1 {
			PB_WeaponRecoil(-3.80,+2.40);
		}
		TNT1 A 0 A_Giveinventory("SSGBarrelHeat2",120)
		P6W2 F 1 {
			//CountInv("DualFiring")==0
			if(CountInv("LeftSSGAmmo")<=0 || CountInv("SSGAmmoCounter")>0){
				A_GiveInventory("DualFiring",1);
			}
		}
		P6W2 GHIJK 1
		TNT1 A 0 {
			if(CountInv("LeftSSGAmmo")<=0){
				A_GiveInventory("DualFireReload",1);
			}
		}
		Goto IdleLeft_Overlay
		RightFlash:
			P6WM AB 1 Bright A_GunFlash
			Stop
	FireRight_Overlay:
		P6W1 A 1 BRIGHT {
			PB_IncrementHeat(10);
			A_Overlay(-6, "RightFlash", true);
			A_OverlayFlags(-6,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-6,STYLE_Add);
			if(CountInv("SSGAmmoCounter") == 1){
				A_AlertMonsters;
				//A_FireBullets(9, 6, 10, 7, "ShotgunPuff");
				PB_FireBullets("PB_10GAPellet",10,8,0,0,6);
				A_StartSound("weapons/shh2", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "shotgun");
				//A_FireCustomMissile("GunFireSmokE", 0, 0, -3, 0, 0, 0);
				//A_FireCustomMissile("GunFireSmoke", 0, 0, -5, 0, 0, 0);
				PB_GunSmoke(-3,0,0); PB_MuzzleFlashEffects(-3,0,0);
				PB_GunSmoke(-5,0,0); PB_MuzzleFlashEffects(-5,0,0);
				A_ZoomFactor(0.95);
				A_SetInventory("PB_SSGFireAnimation1",1);
				PB_TakeAmmo("SSGAmmoCounter", 1, 0);
				A_GiveInventory("SSGSpentR",1);
				A_FireProjectile("ShotgunWad",random(-1,1),0,6,-2,FPF_NOAUTOAIM,random(-1,1));
			}
			else {
				A_AlertMonsters;
				//A_FireBullets (12, 6, 20, 7, "ShotgunPuff");
				PB_FireBullets("PB_10GAPellet_LP",1,0,0,0,0);
				PB_FireBullets("PB_10GAPellet",20,8,0,0,6);
				//A_FireCustomMissile("GunFireSmokE", 0, 0, -3, 0, 0, 0);
				//A_FireCustomMissile("GunFireSmoke", 0, 0, -5, 0, 0, 0);
				PB_GunSmoke(-3,0,0); PB_MuzzleFlashEffects(-3,0,0);
				PB_GunSmoke(-5,0,0); PB_MuzzleFlashEffects(-5,0,0);
				A_StartSound("SSHFIRE", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "shotgun");
				A_ZoomFactor(0.95);
				A_SetInventory("PB_SSGFireAnimation1",1);
				PB_TakeAmmo("SSGAmmoCounter", 2, 0);
				A_GiveInventory("SSGSpentR",2);
				A_FireProjectile("ShotgunWad",random(-1,1),0,10,-2,FPF_NOAUTOAIM,random(-1,1));
				A_FireProjectile("ShotgunWad",random(-1,1),0,6,-2,FPF_NOAUTOAIM,random(-1,1));
			}
		}
		P6W1 B 1 BRIGHT {
			//A_FireCustomMissile("GunFireSmokE", 0, 0, -3, 0, 0, 0);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, -5, 0, 0, 0);
			PB_GunSmoke(-3,0,0); PB_MuzzleFlashEffects(-3,0,0);
			PB_GunSmoke(-5,0,0); PB_MuzzleFlashEffects(-5,0,0);
			}
		P6W1 C 1 {
			A_ZoomFactor(0.975);
			PB_WeaponRecoil(-3.80,-2.40);
		}
		P6W1 D 1 {
			A_ZoomFactor(1.0);
			PB_WeaponRecoil(-3.80,-2.40);
		}
		P6W1 E 1 {
			PB_WeaponRecoil(-3.80,-2.40);
		}
		P6W1 F 1 {
			if(CountInv("LeftSSGAmmo")>0 || CountInv("SSGAmmoCounter")<=0){
				A_TakeInventory("DualFiring",1);
			}
		}
		P6W1 GHIJK 1
		TNT1 A 0 A_Giveinventory("SSGBarrelHeat",120)
		TNT1 A 0 {
			if(CountInv("SSGAmmoCounter")<=0){
				A_GiveInventory("DualFireReload",1);
			}
		}
		Goto IdleRight_Overlay
		
	WeaponSpecial:
		TNT1 A 0 {
			A_SetInventory("GoWeaponSpecialAbility",0);
			A_SetInventory("PB_LockScreenTilt",1);
			A_ClearOverlays(10,11);
			PB_HandleCrosshair(40);
			}
		TNT1 A 0 A_JumpIfInventory("PB_SSG", 2,"SwitchToDualWield")
		TNT1 A 0 A_Print("$PB_SSG_NOAKIMBO")
		Goto Ready3
		
	SwitchToDualWield:
		TNT1 A 0 {
			A_PlaySoundEx("Ironsights", "Auto");
			if (A_CheckAkimbo()) {
				A_SetAkimbo(False);
				return state("SwitchFromDualWield");
			}
			else {
				A_SetAkimbo(True);
				return state("");
			}
		}
		SG3S ABCD 1 
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		SG3S EFGHIJ 1
		Goto ReadyDualWield
	
	SwitchFromDualWield:
		SG3S JIHGFE 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		SG3S DCBA 1 
		Goto Ready3
		
		FullFlash:
			SH2M AB 1 Bright A_GunFlash
			Stop
		HalfFlash1:
			SH2M CD 1 Bright A_GunFlash
			Stop
		HalfFlash2:
			SH2M EF 1 Bright A_GunFlash
			Stop
	Fire:
		TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			PB_HandleCrosshair(40);
			A_SetInventory("PB_LockScreenTilt",0);
		}
		TNT1 A 0 PB_JumpIfNoAmmo("AltFire2",2,true,true,"")
		SHO9 A 1 BRIGHT {
			PB_IncrementHeat(10);
			PB_IncrementHeat(10, true);
			A_Overlay(-5, "FullFlash", true);
			A_OverlayFlags(-5,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-5,STYLE_Add);
			PB_FireBullets("PB_10GAPellet_LP",1,0,0,0,0);
			PB_FireBullets("PB_10GAPellet",20,8,0,0,6);
			//A_FireCustomMissile("GunFireSmokE", 0, 0, 2, 0, 0, 0);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, -2, 0, 0, 0);
			PB_GunSmoke(-2,0,0); PB_MuzzleFlashEffects(-2,0,0);
			PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
			A_StartSound("SSHFIRE", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "dbshotgun");
			A_ZoomFactor(0.95);
			PB_TakeAmmo("SSGAmmoCounter",2,0);
			A_GiveInventory("SSGSpentR",2);
			A_Giveinventory("SSGBarrelHeat",120);
			A_AlertMonsters;
			}
		SHO9 B 1 BRIGHT {
			//A_FireCustomMissile("GunFireSmokE", 0, 0, 2, 0, 0, 0);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, -2, 0, 0, 0);
			PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
			PB_GunSmoke(-2,0,0); PB_MuzzleFlashEffects(-2,0,0);
			A_FireProjectile("ShotgunWad",random(-2,2),0,3,-4,FPF_NOAUTOAIM,random(-2,2));
			A_FireProjectile("ShotgunWad",random(-2,2),0,-3,-4,FPF_NOAUTOAIM,random(-2,2));
			}
		SHO8 C 1 {
			A_ZoomFactor(0.975);
			PB_WeaponRecoil(-2.20,+0.40);
			}
		SHO8 D 1 {
			A_ZoomFactor(1.0);
			PB_WeaponRecoil(-2.20,+0.40);
			}
		SHO8 EFGHIJJKLM 1 
		TNT1 A 0 A_JumpIfInventory("PB_Shell", 1, "Reload")
		Goto Ready3
		
	AltFire:
		TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			PB_HandleCrosshair(40);
		}
		TNT1 A 0 PB_JumpIfNoAmmo("AltFire2",2,true,true,"")
		SHTA A 1 BRIGHT {
			A_Overlay(-5, "HalfFlash1", true);
			A_OverlayFlags(-5,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-5,STYLE_Add);
			PB_IncrementHeat(10);
			//A_FireBullets(9, 6, 10, 7, "ShotgunPuff");
			PB_FireBullets("PB_10GAPellet",10,7,0,0,6);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, 2, 0, 0, 0);
			PB_GunSmoke(-2,0,0); PB_MuzzleFlashEffects(-2,0,0);
			A_StartSound("weapons/shh2", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "shotgun");
			PB_TakeAmmo("SSGAmmoCounter",1,0);
			A_GiveInventory("SSGSpentR",1);
			A_ZoomFactor(0.98);
			}
		SHTA B 1 BRIGHT {
			A_ZoomFactor(0.99);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, 2, 0, 0, 0);
			PB_GunSmoke(-2,0,0); PB_MuzzleFlashEffects(-2,0,0);
			A_FireProjectile("ShotgunWad",random(-2,2),0,3,-4,FPF_NOAUTOAIM,random(-2,2));
			PB_WeaponRecoil(-1.50,+1.0);
		}
		SHO8 C 1 {
			A_ZoomFactor(1.0);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, 2, 0, 0, 0);
			PB_GunSmoke(-2,0,0); PB_MuzzleFlashEffects(-2,0,0);
			PB_WeaponRecoil(-1.50,+1.0);
		}
		SHO8 LCM 1
		SHT3 A 2
		TNT1 A 0 PB_ReFire("AltFire2")
		Goto Ready3
		
	AltFire2:
		TNT1 A 0 PB_JumpIfNoAmmo
		SHTA C 1 BRIGHT {
			A_Overlay(-5, "HalfFlash2", true);
			A_OverlayFlags(-5,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-5,STYLE_Add);
			PB_IncrementHeat(10, true);
			//A_FireBullets(9, 6, 10, 7, "ShotgunPuff");
			PB_FireBullets("PB_10GAPellet",10,7,0,0,6);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, -2, 0, 0, 0);
			PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
			A_StartSound("weapons/shh2", CHAN_Weapon, CHANF_DEFAULT, 1.0);
		  PB_DynamicTail("shotgun", "shotgun");
			PB_TakeAmmo("SSGAmmoCounter",1,0);
			A_GiveInventory("SSGSpentR",1);
			A_ZoomFactor(0.98);
			}
		SHTA D 1 BRIGHT {
			A_ZoomFactor(0.99);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, -2, 0, 0, 0);
			PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
			A_FireProjectile("ShotgunWad",random(-2,2),0,-4,-4,FPF_NOAUTOAIM,random(-2,2));
			PB_WeaponRecoil(-1.50,-1.0);
		}
		SHO8 C 1 {
			A_ZoomFactor(1.0);
			//A_FireCustomMissile("GunFireSmoke", 0, 0, -2, 0, 0, 0);
			PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
			PB_WeaponRecoil(-1.50,-1.0);
		}
		SHO8 LCM 1
		Goto Reload
		
	Reload:
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "ReloadDualWield")
		TNT1 A 0 PB_CheckReload("","","","Ready3","Ready3",2)
		TNT1 A 0 {
			A_SetInventory("PB_LockScreenTilt",1);
			A_SetInventory("PB_SSGFireAnimation1",0);
			A_SetInventory("PB_SSGFireAnimation2",0);
			A_SetCrosshair(-1);
			}
		TNT1 A 0 A_DoPBWeaponAction(WRF_NOFIRE)
		SG10 ABC 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SG10 DEFG 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		TNT1 A 0 A_JumpIfInventory("SSGAmmoCounter", 1, 1)
		Goto FullReload
	HalfReload:
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
			}
			A_SetInventory("SSGSpentR",0);
		}
		SG12 AB 1 A_SetRoll(roll-1.0)
		SG12 CDEFGHIJ 1
		SG12 KL 1 A_SetRoll(roll+2.0)
		SG12 MNO 1 A_SetRoll(roll-1.0)
		TNT1 A 0 {
			A_PlaySoundEx("weapons/ssg/inspect2", "Auto");
			PB_AmmoIntoMag("SSGAmmoCounter","PB_Shell",2,1);
			PB_SetMagEmpty(false);
			PB_SetChamberEmpty(false);
		}
		SG10 WXY 1 A_SetRoll(roll-1.0)
		SG10 Z 1
		SG11 ABC 1
		SG12 YZ 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect3", "Auto")
		SG11 FGHIJKLMNOPQRST 1
		SHT3 A 1 PB_ReFire
		Goto Ready3
	FullReload:
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",14,-3,30,-1,4,4);
				if(CountInv("SSGSpentR") > 1) {
					PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
				}
			}
			A_SetInventory("SSGSpentR",0);
		}
		SG10 HI 1 A_SetRoll(roll-1.0)
		SG10 JKLMNOPQ 1
		SG10 RS 1 A_SetRoll(roll+2.0)
		SG10 TUV 1 A_SetRoll(roll-1.0)
		TNT1 A 0 {
			A_PlaySoundEx("weapons/ssg/inspect2", "Auto");
			PB_AmmoIntoMag("SSGAmmoCounter","PB_Shell",2,1);
			PB_SetMagEmpty(false);
			PB_SetChamberEmpty(false);
		}
		SG10 WXY 1 A_SetRoll(roll-1.0)
		SG10 Z 1
		SG11 ABCDE 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect3", "Auto")
		SG11 FGHIJKLMNOPQRST 1
		SHT3 A 1 PB_ReFire
		Goto Ready3
	NoAmmoDualWield:
		TNT1 A 1
		Goto Ready3
		
	ReloadDualWield:
		TNT1 A 0 PB_CheckReload("","","","ReloadOnlyLeft","Ready3",2)
		TNT1 A 0 A_ClearOverlays(10,11)
		P6SS ED 1 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		P6SS CBA 1 A_SetPitch(pitch+0.4, SPF_INTERPOLATE)
		TNT1 A 3
	ReloadRight:
		SGAR ABCDEFGHI 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SGAR KJOP 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		TNT1 A 0 A_JumpIfInventory("SSGAmmoCounter",1,"HalfReloadRight")
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",14,-3,30,-1,4,4);
				if(CountInv("SSGSpentR") > 1) {
					PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
				}
			}
			A_SetInventory("SSGSpentR",0);
		}
		SG10 HI 1 A_SetRoll(roll-1.0)
		SG10 JKLMNOPQ 1
		SG10 RS 1 A_SetRoll(roll+2.0)
		SG10 TUV 1 A_SetRoll(roll-1.0)
		TNT1 A 0 {
			A_PlaySoundEx("weapons/ssg/inspect2", "Auto");
			PB_AmmoIntoMag("SSGAmmoCounter","PB_Shell",2,1);
			PB_SetMagEmpty(false);
			PB_SetChamberEmpty(false);
		}
		SG10 WXY 1 A_SetRoll(roll-1.0)
		SG10 Z 1
		SG11 ABCDE 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect3", "Auto")
		SG11 FGHIJKLMNO 1
		SGAR QR 1
		TNT1 A 3
		TNT1 A 0 A_JumpIf(CountInv("LeftSSGAmmo") == 2 || CountInv("PB_Shell") < 1,"FinishReloadDualWield")
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		Goto ReloadLeft
	ReloadOnlyLeft:
		TNT1 A 0 PB_CheckReload("","","","Ready3","Ready3",2,1,true)
		TNT1 A 0 A_ClearOverlays(10,11)
		P6SS ED 1 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		P6SS CBA 1 A_SetPitch(pitch+0.4, SPF_INTERPOLATE)
		TNT1 A 3
	ReloadLeft:
		SGAL ABCDEFGHI 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SGAL KJOP 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		TNT1 A 0 A_JumpIfInventory("LeftSSGAmmo",1,"HalfReloadLeft")
		TNT1 A 0 {
			if(CountInv("SSGSpentL") > 1) {
				PB_SpawnCasing("ShotgunCasing",14,3,30,-1,-5,4);
				PB_SpawnCasing("ShotgunCasing",15,-3,30,-1,-4,4);
			}
			A_SetInventory("SSGSpentL",0);
		}
		SGAL QR 1 A_SetRoll(roll+1.0)
		SGAL STUVWXYZ 1
		S1AL AB 1 A_SetRoll(roll-2.0)
		S1AL CDE 1 A_SetRoll(roll+1.0)
		TNT1 A 0 {
			A_PlaySoundEx("weapons/ssg/inspect2", "Auto");
			PB_AmmoIntoMag("LeftSSGAmmo","PB_Shell",2,1);
			PB_SetMagEmpty(false,true);
			PB_SetChamberEmpty(false,true);
		}
		S1AL FGH 1 A_SetRoll(roll+1.0)
		S1AL IJKLMN 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect3", "Auto")
		S1AL OPQRSTUVWXYZ 1
	FinishReloadDualWield:
		TNT1 A 0 A_SetInventory("DualFireReload",0)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		TNT1 A 3
		P6SS ABC 1 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		P6SS DE 1 A_SetPitch(pitch+0.4, SPF_INTERPOLATE)
		Goto ReadyDualWield
		
	Unload:
		TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "UnloadDualWield")
		TNT1 A 0 A_JumpIf(PB_GetChamberEmpty && CountInv("SSGSpentR") == 0,"Ready3")
		SG10 ABC 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SG10 DEF 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_JumpIf(CountInv("SSGAmmoCounter") < 1,"UnloadEmpty")
		SG10 Y 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		SG10 XW 1
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
			}
			A_SetInventory("SSGSpentR",0);
			A_PlaySound("weapons/ssg/inspect2", 0);
			PB_UnloadMag("SSGAmmoCounter","PB_Shell",1,1,1,0,"PB_SingleShell");
			PB_SetChamberEmpty(true);
			PB_SetMagEmpty(true);
		}
		SG10 VUTSRQPONMLK 1
		Goto FinishUnload
	UnloadEmpty:
		SG10 G 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",14,-3,30,-1,4,4);
				if(CountInv("SSGSpentR") > 1) {
					PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
					PB_SetChamberEmpty(true);
				}
			}
			A_SetInventory("SSGSpentR",0);
		}
		SG10 HI 1 A_SetRoll(roll-1.0)
	FinishUnload:
		SG10 J 5
		SG10 IHG 1
		TNT1 A 0 A_PlaySound("weapons/ssg/inspect3", 0)
		SG1S DCBA 1
		Goto Ready3
	UnloadDualWield:
		TNT1 A 0 A_JumpIf(PB_GetChamberEmpty && CountInv("SSGSpentR") == 0 && PB_GetChamberEmpty(true) && CountInv("SSGSpentL") == 0,"Ready3")
		TNT1 A 0 A_ClearOverlays(10,11)
		P6SS ED 1 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		P6SS CBA 1 A_SetPitch(pitch+0.4, SPF_INTERPOLATE)
		TNT1 A 3
		TNT1 A 0 A_JumpIf(CountInv("SSGSpentR") == 0 && PB_GetChamberEmpty,"UnloadLeft")
		SGAR ABCDEFGHI 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SGAR KJOP 1
		TNT1 A 0 A_JumpIf(CountInv("SSGAmmoCounter") < 1,"UnloadEmptyRight")
		SG10 Y 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		SG10 XW 1
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
			}
			A_SetInventory("SSGSpentR",0);
			A_PlaySound("weapons/ssg/inspect2", 0);
			PB_UnloadMag("SSGAmmoCounter","PB_Shell",1,1,1,0,"PB_SingleShell");
			PB_SetChamberEmpty(true);
			PB_SetMagEmpty(true);
		}
		SG10 VUTSRQPONMLK 1
		Goto FinishUnloadRight
	UnloadEmptyRight:
		SG10 G 1 A_SetRoll(roll+0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		TNT1 A 0 {
			if(CountInv("SSGSpentR") > 0) {
				PB_SpawnCasing("ShotgunCasing",14,-3,30,-1,4,4);
				if(CountInv("SSGSpentR") > 1) {
					PB_SpawnCasing("ShotgunCasing",15,3,30,-1,5,4);
					PB_SetChamberEmpty(true);
				}
			}
			A_SetInventory("SSGSpentR",0);
		}
		SG10 HI 1 A_SetRoll(roll-1.0)
	FinishUnloadRight:
		SG10 J 5
		SG10 IHG 1
		TNT1 A 0 A_PlaySound("weapons/ssg/inspect3", 0)
		TNT1 A 3
		TNT1 A 0 A_JumpIf(CountInv("SSGSpentL") == 0 && PB_GetChamberEmpty(true),"FinishDualUnload")
	UnloadLeft:
		SGAL ABCDEFGHI 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open", "Auto")
		SGAL KJOP 1
		TNT1 A 0 A_JumpIf(CountInv("LeftSSGAmmo") < 1,"UnloadEmptyLeft")
		S1AL F 1
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		S1AL ED 1
		TNT1 A 0 {
			A_SetInventory("SSGSpentL",0);
			A_PlaySound("weapons/ssg/inspect2", 0);
			PB_UnloadMag("LeftSSGAmmo","PB_Shell",1,1,1,0,"PB_SingleShell");
			PB_SetChamberEmpty(true,true);
			PB_SetMagEmpty(true,true);
		}
		S1AL CBA 1
		SGAL YXWVU 1
		Goto FinishUnloadLeft
	UnloadEmptyLeft:
		SGAL Q 1 A_SetRoll(roll-0.5)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/open2", "Auto")
		TNT1 A 0 {
			PB_SpawnCasing("ShotgunCasing",14,3,30,-1,-5,4);
			PB_SpawnCasing("ShotgunCasing",15,-3,30,-1,-4,4);
			A_SetInventory("SSGSpentL",0);
			A_PlaySound("weapons/ssg/inspect2", 0);
			PB_UnloadMag("LeftSSGAmmo","PB_Shell",1,1,1,0,"PB_SingleShell");
			PB_SetChamberEmpty(true,true);
			PB_SetMagEmpty(true,true);
		}
		SGAL RS 1 A_SetRoll(roll+1.0)
	FinishUnloadLeft:
		SGAL T 5
		SGAL SRQ 1
		TNT1 A 0 A_PlaySound("weapons/ssg/inspect3", 0)
		TNT1 A 3
	FinishDualUnload:
		P6SS ABC 1 A_SetPitch(pitch-0.4, SPF_INTERPOLATE)
		TNT1 A 0 A_PlaySoundEx("weapons/ssg/inspect4", "Auto")
		P6SS DE 1 A_SetPitch(pitch+0.4, SPF_INTERPOLATE)
		Goto Ready3
	
	DualWieldFlashPunching:
		TNT1 A 15
		Goto Ready3
	DualWieldFlashKicking:
		P6SK ABCDEFGGGFEDCBA 1
		Goto Ready3
	DualWieldFlashAirKicking:
		P6SK ABCDEFGGGFEDCBA 1
		P6SK AAA 1
		Goto Ready3
	DualWieldFlashSlideKicking:
		P6SK ABCDEFGGGGGGGGGGGGGFEDCBA 1
		Goto Ready3
	DualWieldFlashSlideKickingStop:
		P6SK FEDCA 1 
		P6SK AAA 1
		Goto Ready3
		
	FlashPunching:
		TNT1 A 0 A_ClearOverlays(10,11)
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "DualWieldFlashPunching")
		SG21 ABCDEFGGGFEDCBA 1 
		Goto Ready3
	FlashKicking:
		TNT1 A 0 A_ClearOverlays(10,11)
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "DualWieldFlashKicking")
		SG20 ABCDEFGGGFEDCBA 1 
		Goto Ready3
	FlashAirKicking:
		TNT1 A 0 A_ClearOverlays(10,11)
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "DualWieldFlashAirKicking")
		SG20 ABCDEFGGGFEDCBA 1
		SHT3 AAA 1
		Goto Ready3
	FlashSlideKicking:
		TNT1 A 0 A_ClearOverlays(10,11)
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "DualWieldFlashSlideKicking")
		SG20 ABCDEFGGGGGGGGGGGGGFEDCBA 1
		Goto Ready3
	FlashSlideKickingStop:
		TNT1 A 0 A_ClearOverlays(10,11)
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "DualWieldFlashSlideKickingStop")
		SG20 FEDCA 1 
		SHT3 AAA 1
		Goto Ready3
	}
}
