	DualFireReload:
		TNT1 A 0 A_SetInventory("DualFiring",0)
		TNT1 A 0 A_SetInventory("DualFireReload",0)
		TNT1 A 0 PB_CheckReload("","","","ReloadAkimboOnlyLeftBegin","Ready3",4)
		TNT1 A 0 A_ClearOverlays(10, 14)
	ReloadAkimboRight:
		QAKS NOPQR 1
		TNT1 A 6
		QSSG IJKLMNOPQ 1
		TNT1 A 0 A_PlaySound("QSGOPN", 8)
		QRS3 A 0 A_JumpIfInventory("QSSGAmmoCounter", 3, 4)
		QRS2 A 0 A_JumpIfInventory("QSSGAmmoCounter", 2, 3)
		QRS1 A 0 A_JumpIfInventory("QSSGAmmoCounter", 1, 2)
		QRS0 A 0
		"####" A 0
		"####" A 0 {
			if (CountInv("QSSGSpentR") > 3) {PB_SpawnCasing("ShotgunCasing",14,-3,28,-1,4,4);}
			if (CountInv("QSSGSpentR") > 2) {PB_SpawnCasing("ShotgunCasing",14,-3,32,-1,4,4);}
			if (CountInv("QSSGSpentR") > 1) {PB_SpawnCasing("ShotgunCasing",15,3,28,-1,4,4);}
