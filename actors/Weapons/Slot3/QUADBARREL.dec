				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));
				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));
				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));
				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));
				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));
				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));
				A_FireCustomMissile("Tracer", Random(-7, 7), 0, -1, Random(-7, 7));*/
			}
		else	{
			A_FireCustomMissile("QuadDemonicBreath4Blast");
 			A_FireCustomMissile("ShakeYourAssDouble");
			A_PlaySound("QSGCHRG", 8);
			}
			A_Overlay(-5, "FullFlash", true);
			A_OverlayFlags(-5,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-5,STYLE_Add);
		}
		QSF4 B 1 BRIGHT

		TNT1 AA 0 { PB_GunSmoke(0,0,0); PB_MuzzleFlashEffects(0,0,0); } //A_FireCustomMissile("GunFireSmokE", 0, 0, 2, 0, 0, 0)
		TNT1 A 0 A_ZoomFactor(0.950)
		TNT1 A 0 PB_WeaponRecoil(-16,0)
		TNT1 A 0 A_ZoomFactor(0.965)
		QSF4 C 1
		TNT1 A 0 PB_WeaponRecoil(-8,0)
		TNT1 A 0 A_ZoomFactor(0.985)
		QSF4 D 1
		TNT1 A 0 PB_WeaponRecoil(-4,0)
		TNT1 A 0 A_ZoomFactor(0.995)
		QSF4 E 1
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_SetInventory("Reloading", 0)
		QSF4 FGHIK 1
		QSF4 LMNOPQR 1 A_DoPBWeaponAction(WRF_NOFIRE)
		//QSSG A 1 A_DoPBWeaponAction(WRF_NOFIRE)
		TNT1 A 0 A_JumpIfInventory("PB_Shell", 1, 1)
		Goto RealReady
		TNT1 A 0
		Goto Reload
	
	//Note: Right barrel fires FIRST, followed by left SECOND
	HalfBlast:
		TNT1 A 0 A_JumpIfInventory("QSSGAmmoCounter", 4, "FireRightBarrels")
		TNT1 A 0 A_JumpIfInventory("QSSGAmmoCounter", 2, "FireLeftBarrels")
		TNT1 A 0 A_JumpIfInventory("QSSGAmmoCounter", 1, "FireLeftSingleBarrel")
		TNT1 A 0 PB_jumpIfNoAmmo
		HalfFlash1:
			QSFM CD 1 Bright A_GunFlash
			Stop
	FireRightBarrels:
		TNT1 AAAAA 0
		TNT1 A 0 A_Recoil(1)
		QSF2 A 1 BRIGHT {
			A_StartSound("SSHFIRE", CHAN_Weapon, CHANF_DEFAULT, 1.0);//NEED A LOUDER FUCKING BANG
