			A_OverlayFlags(-5,PSPF_RENDERSTYLE,true);
			A_OverlayRenderStyle(-5,STYLE_Add);
		}	
		TNT1 A 0 PB_WeaponRecoil(-12,+0.80) //Add some recoil - sarge945
		QSF2 B 1 BRIGHT
		
