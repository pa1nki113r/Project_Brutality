					PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
					A_PlaySound("QSGCHRG", 8);
				}
				return state ("LeftRecoil_FullBlast");
			}
			else if (CountInv("LeftQSSGAmmoCounter") >= 2) {
				A_AlertMonsters;
