		TNT1 A 0 PB_WeaponRecoil(-3.0,+2.0) 
		TNT1 A 0 { PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0); }//A_FireCustomMissile("GunFireSmokE", 0, 0, -2, 0, 0, 0)
		QSF1 H 1 A_ZoomFactor(0.950)
		QSF1 I 1 A_ZoomFactor(0.965)
		QSF1 J 1 A_ZoomFactor(0.985)
