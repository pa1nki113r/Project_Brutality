				A_GiveInventory("DualFireReload",1);
			}
		}
		Goto IdleRight_Overlay

	WeaponSpecial:
		TNT1 A 0 {
			A_SetInventory("PB_LockScreenTilt",1);
			A_SetInventory("GoWeaponSpecialAbility",0);
			A_SetInventory("Zoomed",0);
			A_SetInventory("ADSmode",0);
			if(CountInv("FullBlastMode") == 1) {
				PB_HandleCrosshair(41);
			}
			else {
				PB_HandleCrosshair(40);
			}
			A_ZoomFactor(1.0);
			A_ClearOverlays(10,11);
			A_PlaySoundEx("Ironsights", "Auto");
		}
		
		TNT1 A 0 A_JumpIfInventory("SelectDualWieldQuads", 1, "DualWield")
		TNT1 A 0 A_JumpIfInventory("BreathToggle", 1, "ToggleBreath")
		TNT1 A 0 A_JumpIfInventory("BlastToggle", 1, "ToggleFullBlast")
		goto Ready3
	DualWield:
		TNT1 A 0 {
			A_SetInventory("BlastToggle",0);
			A_SetInventory("SelectDualWieldQuads",0);
			A_SetInventory("BreathToggle",0);
		}
		TNT1 A 0 A_JumpIfInventory("PB_QuadSG", 2, "DualWieldSelect")
		TNT1 A 0 A_Print("$PB_QSG_NOAKIMBO")
		goto ready3
	DualWieldSelect:
		TNT1 A 0 {
			A_PlaySoundEx("Ironsights", "Auto");
			if (A_CheckAkimbo()) {
				A_SetAkimbo(False);
				return state("SwitchFromDualWield");
			}
			else {
				A_SetAkimbo(True);
				return state("");
			}
		}
		QAKS CD 1
		TNT1 A 0 A_PlaySound("CLIPINSS")
		QAKS EFGHIJKL 1
		Goto ReadyDualWield
	StopDualWield:
	SwitchFromDualWield:
		TNT1 A 0 A_SetAkimbo(False)
		QAKS LKJIHGFE 1
		TNT1 A 0 A_PlaySound("CLIPINSS")
		QAKS DC 1
		goto Ready3
	
	ToggleBreath:
		TNT1 A 0 {
			A_SetInventory("BlastToggle",0);
			A_SetInventory("SelectDualWieldQuads",0);
			A_SetInventory("BreathToggle",0);
		}
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "ToggleBreathAkimbo")
		TNT1 A 0 A_JumpIfInventory("BreathMode", 1,"ToggleStandardMode")
		TNT1 A 0 A_SetInventory("BreathMode",1)
		QSMS ABCDEFGH 1
		TNT1 A 0 A_Print("$PB_QSG_DBREATH")
		TNT1 A 0 A_Playsound("CLIPINQS")
		QSMS KLMNNMLKJGFEDCBA 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3
		
	ToggleStandardMode:
		TNT1 A 0 A_SetInventory("BreathMode",0)
		QSMS ABCDEFGH 1
		TNT1 A 0 A_Print("$PB_QSG_SHELLS")
		TNT1 A 0 A_Playsound("CLIPINQS")
		QSMS KLMNNMLKJGFEDCBA 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3

	ToggleBreathAkimbo:
		TNT1 A 0 A_JumpIfInventory("BreathMode", 1,"ToggleStandardModeAkimbo")
		TNT1 A 0 A_SetInventory("BreathMode",1)
		QS2M CDEFGGGG 1
		TNT1 A 0 A_Print("$PB_QSG_DBREATH")
		TNT1 A 0 A_Playsound("CLIPINQS")
		QS2M HIJJJIHGGFEDC 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3
	
	ToggleStandardModeAkimbo:
		TNT1 A 0 A_SetInventory("BreathMode",0)
		QS2M CDEFGGGG 1
		TNT1 A 0 A_Print("$PB_QSG_SHELLS")
		TNT1 A 0 A_Playsound("CLIPINQS")
		QS2M HIJJJIHGGFEDC 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3

	ToggleFullBlast:
		TNT1 A 0 {
			A_SetInventory("BlastToggle",0);
			A_SetInventory("SelectDualWieldQuads",0);
			A_SetInventory("BreathToggle",0);
		}
		TNT1 A 0 A_JumpIf(A_CheckAkimbo, "ToggleFullBlastAkimbo")
		TNT1 A 0 A_JumpIfInventory("FullBlastMode", 1,"ToggleHalfBlastMode")
		TNT1 A 0 A_SetInventory("FullBlastMode",1)
		QSMS ABCDEFGH 1
		TNT1 A 0 {
			 A_Print("$PB_QSG_FULL");
			A_Playsound("CLIPINQS");
			PB_HandleCrosshair(41);
		}
		QSMS KLMNNMLKJGFEDCBA 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3

	ToggleFullBlastAkimbo:
		TNT1 A 0 A_JumpIfInventory("FullBlastMode", 1,"ToggleHalfModeAkimbo")
		TNT1 A 0 A_SetInventory("FullBlastMode",1)
		QS2M CDEFGGGG 1
		TNT1 A 0 {
			A_Print("$PB_QSG_FULL");
			A_Playsound("CLIPINQS");
			PB_HandleCrosshair(41);
		}
		QS2M HIJJJIHGGFEDC 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3
		
	ToggleHalfBlastMode:
		TNT1 A 0 A_SetInventory("FullBlastMode",0)
		QSMS ABCDEFGH 1
		TNT1 A 0 {
			A_Print("$PB_QSG_HALF");
			A_Playsound("CLIPINQS");
			PB_HandleCrosshair(40);
		}
		QSMS KLMNNMLKJGFEDCBA 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3
	
	ToggleHalfModeAkimbo:
		TNT1 A 0 A_SetInventory("FullBlastMode",0)
		QS2M CDEFGGGG 1
		TNT1 A 0 {
			A_Print("$PB_QSG_HALF");
			A_Playsound("CLIPINQS");
			PB_HandleCrosshair(40);
		}
		QS2M HIJJJIHGGFEDC 1
		TNT1 A 0 A_SetInventory("GoWeaponSpecialAbility",0)
		Goto Ready3
		
	Fire:
		TNT1 A 0 {
			A_WeaponOffset(0,32);
			A_SetRoll(0);
			if(CountInv("FullBlastMode") == 1) {
				PB_HandleCrosshair(41);
			}
			else {
				PB_HandleCrosshair(40);
			}
			A_SetInventory("PB_LockScreenTilt",0);
		}
		TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "DualFireCheck")
		TNT1 A 0 A_JumpIfInventory("FullBlastMode", 1,"FullBlast")
		Goto HalfBlast
		
		FullFlash:
			QSFM AB 1 Bright A_GunFlash
			Stop
	FullBlast:
		TNT1 A 0 A_JumpIfInventory("QSSGAmmoCounter", 4, 1)
		Goto HalfBlast
		TNT1 AAAAA 0
		TNT1 A 0 {
			A_Recoil(3);
			A_AlertMonsters;
		}
		QSF4 A 1 BRIGHT {
			A_StartSound("QSGFIRE1", CHAN_Weapon, CHANF_DEFAULT, 1.0);//NEED A LOUDER FUCKING BANG
			A_ZoomFactor(0.915);
			PB_TakeAmmo("QSSGAmmoCounter", 4,0);
			A_GiveInventory("QSSGSpentR",4);
		A_FireCustomMissile("YellowFlareSpawn", 15, 0, 0, 0);
		A_FireCustomMissile("YellowFlareSpawn", -15, 0, 0, 0);
			If (CountInv("BreathMode") != 1)
			{
				PB_FireBullets("PB_8GAPellet_LP", 4, 0, 0, 0, 0);				
				PB_FireBullets("PB_8GAPellet", 48,7, 0, 0, 5);
				/*A_FireBullets(0, 0, 1, 100, "shotpuff", 0, 220);
				A_FireBullets(0, 0, 2, 110, "shotpuff", 0, 220);
				A_FireBullets (17, 9, 10, 10, "ShotgunPuff");
				A_FireBullets (17, 9, 10, 10, "ShotgunPuff");
