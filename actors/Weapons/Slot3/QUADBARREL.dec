	FireLeft_Overlay:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInventory("LeftQSSGAmmoCounter",1,1)
		Goto NoAmmoLeftGun
		TNT1 A 0 {
			a_takeinventory("DualFiring");
