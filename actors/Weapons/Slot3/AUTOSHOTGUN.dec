					A_FireCustomMissile("Chunk4",frandom(-2,2),0,0,-4,0,frandom(-2,2));
					A_FireCustomMissile("Chunk1",frandom(-2,2),0,0,-4,0,frandom(-2,2));
					A_FireCustomMissile("YellowFlareSpawn",0,0,0,0);
					A_PlaySoundEx("FLAKFIRE", "Weapon");
					A_AlertMonsters;
					A_ZoomFactor(0.98);
					//A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
					PB_GunSmoke(0,0,0); PB_MuzzleFlashEffects(0,0,0);
					//A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
					PB_GunSmoke(0,0,0); PB_MuzzleFlashEffects(0,0,0);
					A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
					PB_LowAmmoSoundWarning("shotgun");
					PB_TakeAmmo("AutoShotgunAmmo",2,0);
					PB_SetChamberEmpty(true);
					A_Giveinventory("JustFiredAutoshotgun",140);
					A_SetInventory("ASGSpent",1);
					A_GunFlash;
					PB_WeaponRecoil(-2.04,+1.1);
				}
				//TNT1 A 0 A_Takeinventory("AutoShotgunAmmo",2)
				TNT1 AAAAAAAA 0 BRIGHT A_FireCustomMissile("ShotgunParticles", random(-17,17), 0, -1, random(-17,17))
				AUMD B 1 BRIGHT { 
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AU24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AU23");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AU02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AU01");}
					A_ZoomFactor(0.99);
					PB_WeaponRecoil(-2.04,+1.1);
				}
				AUMD C 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AU24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AU23");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AU02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AU01");}
					A_ZoomFactor(1.0);
					PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,2.5);
				}
				TNT1 AA 0 A_FireProjectile("ShotgunWad",random(-1,1),0,random(-1,1),-1,FPF_NOAUTOAIM,random(-1,1)) //Keeping the shotgun wad projectile
				AUMD D 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AU24");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AU01");}
					Return A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB);
					}
				AUMD EF 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AF24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AF23");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AF02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AF01");}
					Return A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB);
					}
				AUMD G 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AF24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AF23");}
					if (CountInv("AutoShotgunAmmo") == 22 ) {A_SetWeaponSprite("AF22");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AF03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AF02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AF01");}
					Return A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB);
					}
				AUMD H 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AF24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AF23");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AF03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AF02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AF01");}
					Return A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB);
					}
				AUMD I 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AF24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AF23");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AF03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AF02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AF01");}
					Return A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB);
					}
				TNT1 A 0 A_JumpIfInventory("AutoShotgunAmmo",1,"Pump")
				Goto Ready3
		
		
		BarrelSmoke3:
			TNT1 A 1 PB_CoolDownBarrel
			TNT1 A 1 PB_CoolDownBarrel(10, 0, 8, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(12, 0, 13, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(14, 0, 16, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(16, 0, 17, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(18, 0, 18, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(22, 0, 19, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(26, 0, 20, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(28, 0, 21, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(32, 0, 22, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(34, 0, 23, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(36, 0, 24, -1, 0, 0, 1, 1, true)
			Stop
		BarrelSmoke4:
			TNT1 A 1 PB_CoolDownBarrel(36, 0, 24, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(36, 0, 23, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(38, 0, 22, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(38, 0, 22, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(36, 0, 23, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(36, 0, 24, -1, 0, 0, 1, 1, true)
			Stop
		BarrelSmoke5:
			TNT1 A 1 PB_CoolDownBarrel(36, 0, 24, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(34, 0, 23, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(32, 0, 22, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(28, 0, 21, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(26, 0, 20, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(22, 0, 19, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(18, 0, 18, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(16, 0, 17, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(14, 0, 16, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(12, 0, 13, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel(10, 0, 8, -1, 0, 0, 1, 1, true)
			TNT1 A 1 PB_CoolDownBarrel
			Stop
		
		// Let's get complicated...
		
		ReloadDualWieldStart:
			TNT1 A 0 A_WeaponOffset(0,32)
			TNT1 A 0 PB_CheckReload("","","","","Ready3",12)
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AG60 NMLKJI 1 A_Setroll(roll-1.0, SPF_INTERPOLATE)
			AG60 HGF 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 ED 1
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag",1,4)
			AG60 CBA 1 
			TNT1 A 0 A_Setroll(0, SPF_INTERPOLATE)
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "RightDrumReload")
		RightReloadStart:
			TNT1 A 0 {
				if (PB_GetMagEmpty) {
					return state("RightEmptyReload");
				}
				if (PB_GetChamberEmpty) {
					return state("Pump");
				}
				if (CountInv("AutoShotgunAmmo") == 12) {
					return state("LeftReloadStart");
				}
				return state("");
			}
			Goto RightBeginNormalReload
		RightEmptyReload:
			TNT1 A 0 {
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke3");
				}
			}
			AG31 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AG31 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG31 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
			AG31 M 1
			AG31 N 1 A_PlaySoundEx("insertshell","Auto")
			AG31 OP 1
			AG31 Q 1 {
				A_PlaySoundEx("weapons/sgpump","Auto");
				A_Giveinventory("AutoShotgunAmmo",1);
				A_Takeinventory("PB_Shell",1);
				PB_SetMagEmpty(false);
				PB_SetChamberEmpty(false);
			}
			AG31 RSTUV 1
			Goto RightNormalReload
		RightBeginNormalReload:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",1);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke3");
				}
			}
			AG30 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			AG30 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG30 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
		RightNormalReload:
			TNT1 A 0 A_JumpIf(CountInv("PB_Shell") == 0,"RightReloadFinished")
			TNT1 A 0 A_JumpIfInventory("AutoShotgunAmmo",12,"RightReloadFinished")
			TNT1 A 0 {
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke4");
				}
			}
			AG30 LMN 1
			AG30 O 1 { 
				A_PlaySoundEx("insertshell","Auto");
				A_Giveinventory("AutoShotgunAmmo",1);
				A_Takeinventory("PB_Shell",1);
				A_SetPitch(pitch-0.2,SPF_INTERPOLATE);
				A_SetAngle(angle+0.2, SPF_INTERPOLATE);
				A_SetRoll(roll-0.4,SPF_INTERPOLATE);
			}
			AG30 PQ 1 {
				A_SetPitch(pitch+0.1,SPF_INTERPOLATE);
				A_SetAngle(angle-0.1, SPF_INTERPOLATE);
				A_SetRoll(roll+0.2,SPF_INTERPOLATE);
				if (PressingFire() || PressingAltFire()) {
					return state("RightReloadFinished");
				}
				return state("");
				
			}
			Loop
		RightReloadFinished:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",0);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke5");
				}
			}
			AG30 LKJIHG 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			AG30 FEDCBA 1
			TNT1 A 0 {
				if (PressingFire() || PressingAltFire()) {
					return state("ReloadDualWieldEnd");
				}
				if (CountInv("LeftASGAmmo") < 12 && CountInv("PB_Shell") >= 1) {
					return state("LeftReloadSwitch");
				}
				return state("");
			}
			Goto ReloadDualWieldEnd
			
		LeftReloadSwitch:
			AG10 FEDCBA 1
			TNT1 A 5
			AG10 ABCDEF 1
		LeftReloadStart:
			TNT1 A 0 {
				if (CountInv("LeftASGAmmo") < 1) {
					return state("LeftEmptyReload");
				}
				return state("");
			}
			Goto LeftBeginNormalReload
		LeftEmptyReload:
			TNT1 A 0 {
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke3");
				}
			}
			AG31 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AG31 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG31 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
			AG31 M 1
			AG31 N 1 {
				A_PlaySoundEx("insertshell","Auto");
			}
			AG31 OP 1
			AG31 Q 1 {
				A_PlaySoundEx("weapons/sgpump","Auto");
				A_Giveinventory("LeftASGAmmo",1);
				A_Takeinventory("PB_Shell",1);
				PB_SetChamberEmpty(false,true);
				PB_SetMagEmpty(false,true);
			}
			AG31 RSTUV 1
			Goto LeftNormalReload
			
		LeftBeginNormalReload:
			AG30 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			AG30 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG30 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
		LeftNormalReload:
			TNT1 A 0 A_JumpIf(CountInv("PB_Shell") == 0,"LeftReloadFinished")
			TNT1 A 0 A_JumpIfInventory("LeftASGAmmo",12,"LeftReloadFinished")
			TNT1 A 0 {
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke4");
				}
			}
			AG30 LMN 1
			AG30 O 1 { 
				A_PlaySoundEx("insertshell","Auto");
				A_Giveinventory("LeftASGAmmo",1);
				A_Takeinventory("PB_Shell",1);
				A_SetPitch(pitch-0.2,SPF_INTERPOLATE);
				A_SetAngle(angle+0.2, SPF_INTERPOLATE);
				A_SetRoll(roll-0.4,SPF_INTERPOLATE);
			}
			AG30 PQ 1 {
				A_SetPitch(pitch+0.1,SPF_INTERPOLATE);
				A_SetAngle(angle-0.1, SPF_INTERPOLATE);
				A_SetRoll(roll+0.2,SPF_INTERPOLATE);
				if (PressingFire() || PressingAltFire()) {
					return state("LeftReloadFinished");
				}
				return state("");
			}
			Loop
		LeftReloadFinished:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",0);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke5");
				}
			}
			AG30 LKJIHG 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			AG30 FEDCBA 1
			TNT1 A 0 {
				if (PressingFire() || PressingAltFire()) {
					return state("ReloadDualWieldEnd");
				}
				return state("");
			}
		ReloadDualWieldEnd:
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag",1,4)
			AG60 ABC 1 A_Setroll(roll-0.5, SPF_INTERPOLATE)
			AG60 DEFGH 1 A_Setroll(roll-0.5, SPF_INTERPOLATE)
			AG60 IJK 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 LM 1 A_Setroll(roll+1.0, SPF_INTERPOLATE)
			AG60 N 1 A_Setroll(0, SPF_INTERPOLATE)
			Goto ReadyDualWield
		
		// Dual Drum Reload
		RightEmptyDrumReload:
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AU34 ABCD 1 
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AU34 EFGHIJKLMNO 1 
			TNT1 A 0 A_PlaysoundEx("weapons/shotgun/detach", "Auto")
			AU34 PQRSTUV 1 
			TNT1 A 0 {
				A_PlaysoundEx("weapons/riflemagslap", "Auto");
				PB_AmmoIntoMag("AutoShotgunAmmo","PB_Shell",23,1);
				PB_SetMagUnloaded(false);
				PB_SetChamberEmpty(false);
				PB_SetMagEmpty(false);
			}
			AU34 WXYZ 1
			AU35 ABCD 1 
			TNT1 A 0 A_PlaySoundEx("weapons/sgpump","Auto")
			AU35 EFG 1
			Goto RightDrumReloadEnd
		RightDrumReload:
			TNT1 A 0 A_JumpIfInventory("AutoShotgunAmmo",24,"LeftDrumReload")
			TNT1 A 0 A_JumpIfInventory("PB_Shell",1,2)
			TNT1 A 0 A_PlaySoundEx("weapons/empty", "Weapon")
			Goto Ready3
		RightDrumReloadAnimation:
			TNT1 A 0 A_JumpIf(PB_GetMagUnloaded,"RightBeginNormalDrumReload")
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload1", "Auto")
			AU30 ABCDEFGHIJ 1
			TNT1 A 0 PB_SetMagUnloaded(true)
			AU30 KLM 1 
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload2", "Auto")
			AU30 NO 1
		RightBeginNormalDrumReload:
			TNT1 A 0 {
				if(PB_GetMagEmpty && !PB_GetMagUnloaded) {A_FireCustomMissile("EmptyASGDrum",-5,0,0,-4);}
				if (PB_GetChamberEmpty) {
					return state("RightEmptyDrumReload");
				}
				return state("");
			}
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AU31 ABCDEFGHIJKLMNOP 1 
			TNT1 A 0 A_PlaysoundEx("weapons/shotgun/detach", "Auto")
			AU31 QRSTUVWXY 1 
			TNT1 A 0 {
				A_PlaysoundEx("weapons/riflemagslap", "Auto");
				PB_AmmoIntoMag("AutoShotgunAmmo","PB_Shell",24,1);
				PB_SetMagUnloaded(false);
				PB_SetMagEmpty(false);
			}
			AU31 Z 1
			AU32 ABCDEFGH 1
		RightDrumReloadEnd:
			AU33 ABCDEFG 1
			TNT1 A 0 A_JumpIf(CountInv("LeftASGAmmo") == 24 && !PB_GetMagUnloaded(true),"ReloadDualWieldEnd")
		LeftReloadSwitch_Dual:
			AU10 HGFE 1
			TNT1 A 5
			TNT1 A 0 A_JumpIf(PB_GetMagUnloaded(true),"LeftReloadSwitch_DualUnload")
			AU10 EFGH 1
			Goto LeftDrumReload
		LeftReloadSwitch_DualUnload:
			AG10 ABCDEFFFF 1
			Goto LeftDrumReload
			
		LeftEmptyDrumReload:
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AU34 ABCD 1 
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AU34 EFGHIJKLMNO 1 
			TNT1 A 0 A_PlaysoundEx("weapons/shotgun/detach", "Auto")
			AU34 PQRSTUV 1 
			TNT1 A 0 {
				A_PlaysoundEx("weapons/riflemagslap", "Auto");
				PB_AmmoIntoMag("LeftASGAmmo","PB_Shell",23,1);
				PB_SetMagUnloaded(false,true);
				PB_SetChamberEmpty(false,true);
				PB_SetMagEmpty(false,true);
			}
			AU34 WXYZ 1
			AU35 ABCD 1 
			TNT1 A 0 A_PlaySoundEx("weapons/sgpump","Auto")
			AU35 EFG 1
			Goto LeftDrumReloadEnd
		LeftDrumReload:
			TNT1 A 0 A_JumpIfInventory("LeftASGAmmo",24,"Ready3")
			TNT1 A 0 A_JumpIfInventory("PB_Shell",1,2)
			TNT1 A 0 A_PlaySoundEx("weapons/empty", "Weapon")
			Goto Ready3
		LeftDrumReloadAnimation:
			TNT1 A 0 A_JumpIf(PB_GetMagUnloaded(true),"LeftBeginNormalDrumReload")
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload1", "Auto")
			AU30 ABCDEFGHIJ 1
			TNT1 A 0 PB_SetMagUnloaded(true,true)
			AU30 KLM 1 
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload2", "Auto")
			AU30 NO 1
		LeftBeginNormalDrumReload:
			TNT1 A 0 {
				if(PB_GetMagEmpty(true) && !PB_GetMagUnloaded(true)) {A_FireCustomMissile("EmptyASGDrum",-5,0,0,-4);}
				if (PB_GetChamberEmpty(true)) {
					return state("LeftEmptyDrumReload");
				}
				return state("");
			}
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AU31 ABCDEFGHIJKLMNOP 1 
			TNT1 A 0 A_PlaysoundEx("weapons/shotgun/detach", "Auto")
			AU31 QRSTUVWXY 1 
			TNT1 A 0 {
				A_PlaysoundEx("weapons/riflemagslap", "Auto");
				PB_AmmoIntoMag("LeftASGAmmo","PB_Shell",24,1);
				PB_SetMagUnloaded(false,true);
				PB_SetMagEmpty(false,true);
			}
			AU31 Z 1
			AU32 ABCDEFGH 1
		LeftDrumReloadEnd:
			AU33 ABCDEFG 1
			Goto ReloadDualWieldEnd
			
			
		
		// End of Dual Wield
			
		Reload:
			TNT1 A 0 A_JumpIf(A_CheckAkimbo, "ReloadDualWieldStart")	
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "DrumReload")
			TNT1 A 0 PB_CheckReload("","EmptyReload","Pump","Ready3","Ready3",12)
			Goto BeginNormalReload
		EmptyReload:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",1);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				A_Overlay(999,"BarrelSmoke3");
			}
			AG31 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AG31 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG31 GHI 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
			TNT1 A 0 {if(CountInv("ASGSpent") == 1) {PB_SpawnCasing("ShotgunCasing",15,-8,27,0,3,3); A_SetInventory("ASGSpent",0);}}
			AG31 JKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
			AG31 M 1
			TNT1 A 0 A_PlaySoundEx("insertshell","Auto")
			AG31 NOP 1
			TNT1 A 0 {
				A_PlaySoundEx("weapons/sgpump","Auto");
				A_Giveinventory("AutoShotgunAmmo",1);
				A_Takeinventory("PB_Shell",1);
				PB_SetMagEmpty(false);
				PB_SetChamberEmpty(false);
			}
			AG31 QRSTUV 1
			Goto NormalReload
		BeginNormalReload:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",1);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				A_Overlay(999,"BarrelSmoke3");
			}
			AG30 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			AG30 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG30 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
		NormalReload:
			TNT1 A 0 A_JumpIf(CountInv("PB_Shell") == 0 || CountInv("AutoShotgunAmmo") == 12,"ReloadFinished")
			TNT1 A 0 A_Overlay(999,"BarrelSmoke4")
			AG30 LMN 1
			TNT1 A 0 { 
				A_PlaySoundEx("insertshell","Auto");
				A_Giveinventory("AutoShotgunAmmo",1);
				A_Takeinventory("PB_Shell",1);
			}
			AG30 O 1 {
				A_SetPitch(pitch-0.2,SPF_INTERPOLATE);
				A_SetAngle(angle+0.2, SPF_INTERPOLATE);
				A_SetRoll(roll-0.4,SPF_INTERPOLATE);
			}
			AG30 PQ 1 {
				A_SetPitch(pitch+0.1,SPF_INTERPOLATE);
				A_SetAngle(angle-0.1, SPF_INTERPOLATE);
				A_SetRoll(roll+0.2,SPF_INTERPOLATE);
				if (PressingFire() || PressingAltFire()) {
					return state("ReloadFinished");
				}
				return state("");
			}
			Loop
		ReloadFinished:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",0);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				A_Overlay(999,"BarrelSmoke5");
			}
			AG30 LKJIHG 1
			AG30 FEDCBA 1
			TNT1 A 0 A_JumpIf(A_CheckAkimbo, "ReloadDualWieldEnd")	
			TNT1 A 0 PB_SetReloading(false)
			Goto Ready3
			
		// Drum Reload
		EmptyDrumReload:
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload1", "Auto")
			ARMD ABCDEFGHIJ 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AR23");}
					if (CountInv("AutoShotgunAmmo") == 22 ) {A_SetWeaponSprite("AR22");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AR03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AR02");}
					if (CountInv("AutoShotgunAmmo") == 1 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AR01");}
					}
			TNT1 A 0 PB_SetMagUnloaded(true)
			ARMD K 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AR23");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 1 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AR01");}
					}
			ARMD L 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 1 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AR01");}
					}
			ARMD M 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AR23");}
					}
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload2", "Auto")
			AU30 NO 1
			TNT1 A 0 A_FireCustomMissile("EmptyASGDrum",-5,0,0,-4)
			AV24 LMN 0
			AV01 LMN 0
			AV02 N 0
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AU34 ABCD 1 
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AU34 EFGHIJK 1 
			TNT1 A 0 PB_SetMagUnloaded(true)
		DrumEmptyUnloaded:
			AVMD LMN 1
			AU34 O 1
			TNT1 A 0 A_PlaysoundEx("weapons/shotgun/detach", "Auto")
			AU34 PQRSTUV 1 
			TNT1 A 0 {
				A_PlaysoundEx("weapons/riflemagslap", "Auto");
				PB_AmmoIntoMag("AutoShotgunAmmo","PB_Shell",23,1);
				PB_SetMagUnloaded(false);
				PB_SetChamberEmpty(false);
				PB_SetMagEmpty(false);
			}
			AU34 WXYZ 1
			AU35 ABCD 1 
			TNT1 A 0 A_PlaySoundEx("weapons/sgpump","Auto")
			AU35 EFG 1
			Goto DrumReloadEnd
		DrumReload:
			TNT1 A 0 PB_CheckReload("BeginNormalDrumReload","EmptyDrumReload","Pump","Ready3","Ready3",24)
			AR24 A 0
			AR23 A 0
			AR22 A 0
			AR03 A 0
			AR02 A 0
			AR01 A 0
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload1", "Auto")
			ARMD ABCDEFGHIJ 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AR23");}
					if (CountInv("AutoShotgunAmmo") == 22 ) {A_SetWeaponSprite("AR22");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AR03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AR02");}
					if (CountInv("AutoShotgunAmmo") == 1 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AR01");}
					}
			TNT1 A 0 PB_SetMagUnloaded(true)
			ARMD K 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AR23");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 1 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AR01");}
					}
			ARMD L 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 1 )	{A_SetWeaponSprite("AR01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AR01");}
					}
			ARMD M 1 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AR24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AR23");}
					}
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/drumreload2", "Auto")
			AU30 NO 1
		BeginNormalDrumReload:
			TNT1 A 0 A_PlaysoundEx("Ironsights", "Auto")
			AG30 ABC 1
			AU31 DEFGHI 1
			TNT1 A 0 A_JumpIf(PB_GetChamberEmpty,"DrumEmptyUnloaded")
		ASGDrumRespect:
			AT24 A 0
			AT01 A 0
			AT02 A 0
			AU31 JKL 1 
			ATMD M 1 {
				if (CountInv("AutoShotgunAmmo") + CountInv("PB_Shell") >= 24 ) {A_SetWeaponSprite("AT24");}
				if (CountInv("AutoShotgunAmmo") + CountInv("PB_Shell") <= 1 )	{A_SetWeaponSprite("AT01");}	
			}
			ATMD NO 1 {
				if (CountInv("AutoShotgunAmmo") + CountInv("PB_Shell") >= 24 ) {A_SetWeaponSprite("AT24");}
				if (CountInv("AutoShotgunAmmo") + CountInv("PB_Shell") == 2 )	{A_SetWeaponSprite("AT02");}	
				if (CountInv("AutoShotgunAmmo") + CountInv("PB_Shell") <= 1 )	{A_SetWeaponSprite("AT01");}	
			}
			AU31 P 1 
			TNT1 A 0 A_PlaysoundEx("weapons/shotgun/detach", "Auto")
			AU31 QRSTUVWXY 1 
			TNT1 A 0 {
				A_PlaysoundEx("weapons/riflemagslap", "Auto");
				A_SetInventory("DrumMagNotInserted",0);
				PB_AmmoIntoMag("AutoShotgunAmmo","PB_Shell",24,1);
				PB_SetMagUnloaded(false);
				PB_SetMagEmpty(false);
			}
			AU31 Z 1
			AU32 ABCDEFGH 1
		DrumReloadEnd:
			AU33 ABC 1
			AS24 A 0
			AS23 A 0
			AS22 A 0
			AS03 A 0
			AS02 A 0
			AS01 A 0
			ASMD DE 1 {
				if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AS24");}
				if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AS23");}
				if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AS02");}
				if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AS01");}
			}
			ASMD F 1 {
				if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AS24");}
				if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AS23");}
				if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AS03");}
				if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AS02");}
				if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AS01");}
			}
			ASMD G 1 {
				if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AS24");}
				if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AS23");}
				if (CountInv("AutoShotgunAmmo") == 22 ) {A_SetWeaponSprite("AS22");}
				if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AS03");}
				if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AS02");}
				if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AS01");}
			}
			TNT1 A 0 A_JumpIf(A_CheckAkimbo, "ReloadDualWieldEnd")	
			Goto Ready3
		
		UnloadDualWield:
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
				A_WeaponOffset(0,32);
			}
			TNT1 A 0 A_JumpIfInventory("AutoShotgunAmmo",1,1)
			Goto UnloadLeftOnly
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "UnloadDualDrum")
			AG60 NMLKJI 1 A_Setroll(roll-1.0, SPF_INTERPOLATE)
			AG60 HGF 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 EDCB 1 
			AG60 A 3 A_Setroll(0, SPF_INTERPOLATE)
			Goto StartUnloadAnim
			
		Unload:
			TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "UnloadDualWield")
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "DrumUnload")
			TNT1 A 0 A_JumpIf(PB_GetMagEmpty,"Ready3")
			TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
			}
		StartUnloadAnim:
			AG40 ABCDEFGH 1
		RemoveBullets:
			TNT1 A 0 A_JumpIfInventory("AutoShotgunAmmo",1,1)
			Goto FinishUnload
			TNT1 A 0 {
				PB_UnloadMag("AutoShotgunAmmo","PB_Shell",1,1,1,CountInv("AutoShotgunAmmo") - 1,"PB_SingleShell");
				if(CountInv("AutoShotgunAmmo") < 1) {
					PB_SetMagEmpty(true);
					PB_SetChamberEmpty(true);
				}
				A_PlaysoundEx("H4SGCOCK", "Weapon");
			}
			AG40 IJKLL 1 A_DoPBWeaponAction
			AG40 MN 1 A_DoPBWeaponAction
			Goto RemoveBullets
		FInishUnload:
			AG40 IHGFEDCBA 1
			TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "UnloadNextGun")
			Goto Ready3
		
		UnloadLeftOnly:
			TNT1 A 0 {
				if(CountInv("AutoshotgunAmmo") < 1 && CountInv("LeftASGAmmo") < 1)
				{
					return state("Ready3");
				}
				return state("");
			}
			AG60 NMLKJI 1 
			Goto StartUnloadLeftGun
		UnloadNextGun:
			TNT1 A 0 A_JumpIf(PB_GetMagEmpty(true),"FinishUnloadDualWield")
			AG10 FEDCBA 1
			TNT1 A 0 A_SetInventory("LeftPBAutoShotgunWasEmpty",1)
		StartUnloadLeftGun:
			TNT1 A 5
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "BeginLeftDrumUnload")
		UnloadLeftGun:
			AG10 ABCDEFGGG 1
			AG40 ABCDEFGH 1 A_DoPBWeaponAction
		RemoveBullets_Left:
			TNT1 A 0 A_JumpIfInventory("LeftASGAmmo",1,1)
			Goto FInishUnloadLeft
			TNT1 A 0 {
				PB_UnloadMag("LeftASGAmmo","PB_Shell",1,1,1,CountInv("LeftASGAmmo") - 1,"PB_SingleShell");
				if(CountInv("LeftASGAmmo") < 1) {
					PB_SetMagEmpty(true);
					PB_SetChamberEmpty(true);
				}
				A_PlaysoundEx("H4SGCOCK", "Weapon");
			}
			AG40 IJKLL 1 A_DoPBWeaponAction
			AG40 MN 1 A_DoPBWeaponAction
			Goto RemoveBullets_Left
		FInishUnloadLeft:
		AG40 IHGFEDCBA 1 A_DoPBWeaponAction
		TNT1 A 0 A_SetInventory("LeftPBAutoShotgunWasEmpty", 1)
		FinishUnloadDualWield:
		AG60 ABCDEFGH 1 A_Setroll(roll-0.5, SPF_INTERPOLATE)
			AG60 IJK 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 LM 1 A_Setroll(roll+1.0, SPF_INTERPOLATE)
			AG60 N 1 A_Setroll(0, SPF_INTERPOLATE)
			Goto ReadyDualWield
		
		UnloadDualDrum:
			AG60 NMLKJI 1 A_Setroll(roll-1.0, SPF_INTERPOLATE)
			AG60 HGF 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 EDCB 1 
			TNT1 A 0 A_Setroll(0, SPF_INTERPOLATE)
			AU2M H 3 {
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AU24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AU23");}
					if (CountInv("AutoShotgunAmmo") == 22 ) {A_SetWeaponSprite("AU22");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AU03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AU02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AU01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AU01");}
				}
		DrumUnload:
			AS24 DEFG 0
			AS23 DEFG 0
			AS22 G 0
			AS03 FG 0
			AS02 DEFG 0
			AS01 DEFG 0
