// --------------------------------------------------------------------------
//
// Auto-Shotgun
//
// --------------------------------------------------------------------------

Actor AutoshotgunDrumMag: Inventory{inventory.maxamount 1}

Actor PBAutoShotgunHasUnloaded: Inventory{Inventory.maxamount 1}

Actor LeftPBAutoShotgunHasUnloaded : PBAutoShotgunHasUnloaded{}

Actor PBAutoShotgunWasEmpty: Inventory{Inventory.maxamount 1}

Actor LeftPBAutoShotgunWasEmpty : PBAutoShotgunWasEmpty{}

actor DrumMagNotInserted : Inventory{Inventory.MaxAmount 1}

Actor ASGSpent: Inventory{Inventory.maxamount 1}

Actor JustFiredAutoshotgun: Inventory{Inventory.maxamount 200}

Actor PB_ASGFireAnimation1: Inventory{Inventory.maxamount 1}

Actor PB_ASGFireAnimation2: Inventory{Inventory.maxamount 1}

Actor PB_AutoshotgunUpgrade: PB_UpgradeItem{
	//$Title Autoshotgun Drum Magazine Upgrade
	//$Category Project Brutality - Weapon Upgrades
	//$Sprite A9SCA0
	Game Doom
	SpawnID 9350
	Height 24
	//-COUNTITEM
	-INVENTORY.ALWAYSPICKUP
	-COUNTITEM
	+DONTGIB
	Inventory.Pickupsound "H4SGCOCK"
	Inventory.PickupMessage "$PB_ASG_UPGRADE_PICKUP"
	Tag "Assault Shotgun Magazine"
	Scale 0.52
	FloatBobStrength 0.5
	States{
	Spawn:
		V9SC A 0 NoDelay
		A9SC A 10 A_PbvpFramework("V9SC")
		"####" A 0 A_PbvpInterpolate()
		LOOP
	Pickup:
		//TNT1 A 0 ACS_NamedExecuteAlways("AutoShotgunDrumMag", 0)
		TNT1 A 0 A_JumpIf(!FindInventory("AutoshotgunDrumMag") || CountInv("PB_Autoshotgun") < 2 || CountInv("PB_Shell") < GetAmmoCapacity("PB_Shell"),1)
		fail
		TNT1 A 1{
			if (CountInv("AutoshotgunDrumMag") == 0) {
				A_GiveInventory("DrumMagNotInserted", 1);
				SetAmmoCapacity("AutoShotgunAmmo",24);
				SetAmmoCapacity("LeftASGAmmo",24);
				A_GiveInventory("Autoshotgunammo", 24);
				A_GiveInventory("LeftASGAmmo", 24);
			}
			A_GiveInventory("PB_Autoshotgun", 1);
			A_GiveInventory("AutoshotgunDrumMag", 1);
		}
		Stop
	}
}

ACTOR PB_Autoshotgun : PB_Weapon{
	//$Title Autoshotgun
	//$Category Project Brutality - Weapons
	//$Sprite AUSCA0
	Game Doom
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 8
	Weapon.AmmoGive2 0
	+FLOORCLIP
	+DONTGIB
	Scale 0.52
	Weapon.AmmoType1 "PB_Shell"
	Weapon.AmmoType2 "AutoShotgunAmmo"
	weapon.slotpriority 0.75
	PB_WeaponBase.AmmoTypeLeft "LeftASGAmmo"
	Inventory.PickupMessage "$PB_ASG_PICKUP"
	Inventory.PickupSound "weapons/sgpump"
	Inventory.Amount 1
	Inventory.MaxAmount 2
	Obituary "$OB_MPSHOTGUN"
	AttackSound "None"
	Tag "$PB_ASG_TAG"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	Inventory.AltHUDIcon "AUSCA0"
	FloatBobStrength 0.5
	PB_WeaponBase.OffsetRecoilX 2.5
	PB_WeaponBase.OffsetRecoilY 2.5
	PB_WeaponBase.TailPitch 0.75
	States{
		Steady:
			TNT1 A 1
			Goto Ready
		Ready:
			AU10 ABCDEFGH 0 
			TNT1 A 0 A_JumpIfInventory("GoFatality", 1, "Steady")
			TNT1 A 0 PB_RespectIfNeeded
		WeaponRespect:
			TNT1 A 0 {
				A_SetCrosshair(-1);
				A_SetInventory("PB_LockScreenTilt",1);
				A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto");
			}
			AG10 ABC 1 {
				A_SetRoll(roll-1.5,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG10 DEF 1 {
				A_SetRoll(roll+1.5,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG10 F 1 A_PlaySoundEx("Ironsights", "Auto")
			AG00 ABCDEFGHIJKL 1 {
				A_SetRoll(roll-0.5,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 LLL 1 {
				A_SetRoll(roll+2.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 LLLL 1 A_DoPBWeaponAction
			AG00 MNOPQ 1 
			TNT1 A 0 A_PlaySoundEx("insertshell", "Auto")
			AG00 R 1{
				A_SetRoll(roll-1.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 STT 1{
				A_SetRoll(roll+2.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 UUUU 1 {
				A_SetRoll(roll+0.5,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 UUUU 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaySoundEx("H4SGCOCK", "Auto")
			AG00 V 1 {
				A_SetRoll(roll-2.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 VWXYZZ 1 {
				A_SetRoll(roll-2.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG00 ZZZZ 1 A_DoPBWeaponAction 
			AG01 ABCDE 1 {
				A_SetRoll(roll+1.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}

			TNT1 A 0 {
					if(CountInv("AutoshotgunDrumMag")>=1){
					A_SetRoll(0);
					PB_HandleCrosshair(70);
					A_SetInventory("PB_LockScreenTilt",0);
					Return State("ASGDrumRespect");
					}
					Return State("");}
			AG01 FGHIJ 1 {
			A_SetRoll(roll+1.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG01 KL 1{
				A_SetRoll(roll+1.0,SPF_INTERPOLATE);
				return A_DoPBWeaponAction;
			}
			AG01 MN 1 A_DoPBWeaponAction
			Goto Ready3
		DrumMagInspectCheck:
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_SetInventory("DrumMagNotInserted",0)
			TNT1 A 0 A_JumpIf(A_CheckAkimbo, "DrumMagInspectGoBackToSingle")
			goto BeginNormalDrumReload
		DrumMagInspectGoBackToSingle:
			AG60 NMLKJI 1 A_Setroll(roll-1.0, SPF_INTERPOLATE)
			AG60 HGF 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 EDCB 1 
			AG60 A 1 A_Setroll(0, SPF_INTERPOLATE)
			goto BeginNormalDrumReload
		SelectAnimationDrum:
			AU24 EFG 0
			AU23 EFG 0
			AU02 EFG 0
			AU01 EFG 0
			AU10 ABCD 1 //{if (CountInv("AutoshotgunDrumMag") == 1 ) { A_SetWeaponSprite("AU10");}}
			goto ReadyToFireDrum
		SelectAnimation:
			TNT1 A 0 A_JumpIf(A_CheckAkimbo, "SelectAnimationDualWield")	
			TNT1 A 0 A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto")

			TNT1 A 0 A_JumpIf(CountInv("DrumMagNotInserted") >= 1 && CountInv("PBAutoShotgunHasUnloaded") == 0, "DrumMagInspectCheck")
			TNT1 A 0 A_JumpIf(PB_GetMagUnloaded, 2)
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "SelectAnimationDrum") //Is this even a thing anymore?	Let's make it a thing << Y e s
			AG51 DCBA 1 //{if (CountInv("AutoshotgunDrumMag") == 1 ) { A_SetWeaponSprite("AU10");}}

		Ready3:
			TNT1 A 0
			TNT1 A 0 A_SetInventory("CantDoAction",0)
			TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "ReadyDualWield")
			TNT1 A 0 {
				A_ClearOverlays(10,11);
				A_SetRoll(0);
				PB_HandleCrosshair(70);
				A_SetInventory("PB_LockScreenTilt",0);
			}

		ReadyToFire:
			AG10 H 1 {
					PB_CoolDownBarrel;
					if (CountInv("AutoShotgunAmmo") > 0 ) { A_SetInventory("PBAutoShotgunHasUnloaded",0); }
					if (CountInv("DrumMagNotInserted") >= 1 ) { return state("DrumMagInspectCheck"); }
					if (CountInv("AutoshotgunDrumMag") >= 1 && !PB_GetMagUnloaded) {Return State("ReadyToFireDrum"); }
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD, CheckUnloaded("PBAutoShotgunHasUnloaded"));
			}
			Loop
		ReadyToFireDrum:
			AU01 H 0
			AU02 H 0
			AU03 H 0
			AU22 H 0
			AU23 H 0
			AU24 H 0
			AU2M H 1 {
					A_SetInventory("DrumMagNotInserted",0);
					PB_CoolDownBarrel;
					if (CountInv("AutoShotgunAmmo") > 0 ) { A_SetInventory("PBAutoShotgunHasUnloaded",0); }
					if (CountInv("AutoShotgunAmmo") == 24 ) {A_SetWeaponSprite("AU24");}
					if (CountInv("AutoShotgunAmmo") == 23 ) {A_SetWeaponSprite("AU23");}
					if (CountInv("AutoShotgunAmmo") == 22 ) {A_SetWeaponSprite("AU22");}
					if (CountInv("AutoShotgunAmmo") == 3 )	{A_SetWeaponSprite("AU03");}
					if (CountInv("AutoShotgunAmmo") == 2 )	{A_SetWeaponSprite("AU02");}
					if (CountInv("AutoShotgunAmmo") <= 1 )	{A_SetWeaponSprite("AU01");}
					if (CountInv("AutoShotgunAmmo") == 0 )	{A_SetWeaponSprite("AU01");}
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD, CheckUnloaded("PBAutoShotgunHasUnloaded"));
			}
			Loop
		
		
		
		BarrelSmoke1:
			TNT1 A 1 {
				A_FireCustomMissile("GunBarrelSmoke", 0, 0, 0, 0, 0, 0);
				A_Takeinventory("JustFiredAutoshotgun",1);
			}
			Stop
			
		SelectAnimationDualWield:
			TNT1 A 0 A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto")
			//AG60 IJKLMN 1
			AG60 IJKL 1
			TNT1 A 0 A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto")
		ReadyDualWield:
			TNT1 A 0 {
				A_SetRoll(0);
				PB_HandleCrosshair(70);
				A_SetInventory("PB_LockScreenTilt",0);
				A_SetFiringRightWeapon(False);
				A_SetFiringLeftWeapon(False);
				A_TakeInventory("DualFiring",1);
				if(CountInv("LeftASGAmmo") < CountInv("AutoShotgunAmmo")){
					A_GiveInventory("DualFiring",1);
				}
// 				if(CountInv("PB_Shell")>0){
// 					if(CountInv("LeftASGAmmo")<=0){
// 						A_GiveInventory("DualFireReload",1);
// 					}
// 					if(CountInv("AutoShotgunAmmo")<=0){
// 						A_GiveInventory("DualFireReload",1);
// 					}
// 				}
				A_Overlay(10, "IdleLeft_Overlay", false);
				A_Overlay(11, "IdleRight_Overlay", false);
				if (CountInv("DrumMagNotInserted") >= 1 ) { return state("DrumMagInspectCheck"); }
				Return State("");
			}
		ReadyToFireDualWield:
			TNT1 A 1 
			{
				if (CountInv("AutoShotgunAmmo") > 0 ) { A_SetInventory("PBAutoShotgunHasUnloaded",0); }
				if(CountInv("PB_Shell")>0){
					if(CountInv("LeftASGAmmo")<=0 || CountInv("AutoShotgunAmmo")<=0){
						if(CountInv("LeftASGAmmo")<=0 && CountInv("AutoShotgunAmmo")<=0){
							A_SetInventory("DualFireReload",2);
						}
						else{
							A_SetInventory("DualFireReload",1);
						}
					}
				}
				if (CountInv("DrumMagNotInserted") >= 1 ) { return state("DrumMagInspectCheck"); }
				
				if(!PB_CanDualWield())
				{
					A_ClearOverlays(10,11);
					A_SetAkimbo(false);
					return state("StopDualWield");
				}
				
				Return A_DoPBWeaponAction(WRF_ALLOWRELOAD | WRF_NOFIRE);
			}
			Loop
		IdleLeft_Overlay:
			AG61 J 1 {
				PB_CoolDownBarrel(12);
				if(PB_GetChamberEmpty(true) && !PB_GetChamberEmpty){
					A_GiveInventory("DualFiring",1);
				}
				if((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringLeftWeapon() && GetCvar("SingleDualFire") >=2){
					if(!PB_GetChamberEmpty(true)){
						return state("FireLeft_Overlay");
					}
					else if(JustPressed(BT_ALTATTACK)) {
						A_PlaySoundEx("weapons/empty", "Auto");
						return state("");
					}
				}
				if(CountInv("DualFiring")==0 || (CountInv("DualFiring")==0 && CountInv("AutoShotgunAmmo")<=0) || GetCvar("SingleDualFire")==1){
					if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringLeftWeapon() && GetCvar("SingleDualFire") <=1){
						if(!PB_GetChamberEmpty(true)){
							return state("FireLeft_Overlay");
						}
						else if(JustPressed(BT_ATTACK)) {
							A_PlaySoundEx("weapons/empty", "Auto");
							return state("");
						}
					}
				}
				return state("");
			}
			Loop
		IdleRight_Overlay:
			AG61 I 1 {
				PB_CoolDownBarrel(-12);
				if(!PB_GetChamberEmpty(true) && PB_GetChamberEmpty){
					A_TakeInventory("DualFiring",1);
				}
				if(CountInv("DualFiring")==1 || (CountInv("DualFiring")==1 && PB_GetChamberEmpty(true))){
					if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringLeftWeapon() && GetCvar("SingleDualFire")==0){
						if(!PB_GetChamberEmpty){
							return state("FireRight_Overlay");
						}
						else if(JustPressed(BT_ATTACK)) {
							A_PlaySoundEx("weapons/empty", "Auto");
							return state("");
						}
					}
				}
				if((PressingFire() || JustPressed(BT_ATTACK)) && !A_IsFiringRightWeapon() && GetCvar("SingleDualFire") == 2){
					if(!PB_GetChamberEmpty){
						return state("FireRight_Overlay");
					}
					else if(JustPressed(BT_ATTACK)) {
						A_PlaySoundEx("weapons/empty", "Auto");
						return state("");
					}
				}
				if((PressingAltfire() || JustPressed(BT_ALTATTACK)) && !A_IsFiringRightWeapon()){
					if(!PB_GetChamberEmpty && GetCvar("SingleDualFire")==1){
						return state("FireRight_Overlay");
					}
					if(!PB_GetChamberEmpty && !PB_GetChamberEmpty(true) && GetCvar("SingleDualFire")==0){
						A_Overlay(10, "FireLeft_Overlay", false);
						return state("FireRight_Overlay");
					}
					else if(JustPressed(BT_ALTATTACK)) {
						A_PlaySoundEx("weapons/empty", "Auto");
						return state("");
					}
				}
				return state("");
			}
			Loop
			
		FireLeft_Overlay:
				TNT1 A 0 PB_FireBullets("PB_12GAPellet",4,frandom(5.84,6.45),0,0,frandom(5.2,6.75))
				AG62 A 1 BRIGHT {
					PB_IncrementHeat(2, true);
					A_Overlay(8, "LeftMuzzleFlash", true);
					//A_FireBullets (frandom(5.85,6.65), frandom(5.32,6.75), 4, 8, "MachineGunBulletPuff");
					PB_FireBullets("PB_12GAPellet_ASG",4,frandom(5.85,6.65),0,0,frandom(5.85,6.65));
					//A_FireProjectile("PB_12GAPellet", frandom(-5,5),0,0,0, FPF_NOAUTOAIM, frandom(-5,5));
					A_AlertMonsters;
					PB_LowAmmoSoundWarning("shotgun", "LeftASGAmmo");
					if(CountInv("AutoshotgunDrumMag") == 0) {PB_TakeAmmo("LeftASGAmmo",1,0,0,true);}
					else {PB_TakeAmmo("LeftASGAmmo",1,1,0,true);}
					A_StartSound("Weapons/AutoShotgun", CHAN_Weapon, CHANF_DEFAULT, 1.0);
					PB_DynamicTail("shotgun", "shotgun");
					//A_FireCustomMissile("GunFireSmoke", 0, 0, -2, 1, 0, 0);
					PB_GunSmoke(2,0,0); PB_MuzzleFlashEffects(2,0,0);
					A_FireCustomMissile("YellowFlareSpawn",0,0,-3,0);
					A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
					A_Giveinventory("JustFiredAutoshotgun",20);
					A_GunFlash;
					A_ZoomFactor(0.98);
					PB_WeaponRecoil(-2.30,+1.88);
				}
				AG62 B 1 BRIGHT {
					A_ZoomFactor(0.99);
					PB_WeaponRecoil(-2.30,+1.88);
					A_FireProjectile("ShotgunWad",random(-2,2),0,random(-13,-12),-2,FPF_NOAUTOAIM,random(-2,2));
				}
				AG62 C 1 {
					A_ZoomFactor(1.0);
					PB_SpawnCasing("ShotgunCasing",18,-6,24,0,3,3);
				}
				AG62 D 1 {
					if(CountInv("LeftASGAmmo")<=0 || CountInv("AutoShotgunAmmo")>0 ){
						A_GiveInventory("DualFiring",1);
					}
				}
				AG62 EFGH 1
				TNT1 A 0 {
					if(CountInv("LeftASGAmmo")<=0){
						A_GiveInventory("DualFireReload",1);
					}
				}
				Goto IdleLeft_Overlay
			
		FireRight_Overlay:
				TNT1 A 0 PB_FireBullets("PB_12GAPellet",4,frandom(5.84,6.45),0,0,frandom(5.2,6.75))
				AG61 A 1 BRIGHT {
					PB_IncrementHeat(2);
					A_Overlay(9, "RightMuzzleFlash", true);
					//A_FireBullets (frandom(5.85,6.65), frandom(5.32,6.75), 4, 8, "MachineGunBulletPuff");
					PB_FireBullets("PB_12GAPellet_ASG",4,frandom(5.85,6.65),0,0,frandom(5.32,6.75));
					PB_LowAmmoSoundWarning("shotgun");
					if(CountInv("AutoshotgunDrumMag") == 0) {PB_TakeAmmo("AutoShotgunAmmo",1);}
					else {PB_TakeAmmo("AutoShotgunAmmo",1,1);}
					A_AlertMonsters;
					A_StartSound("Weapons/AutoShotgun", CHAN_Weapon, CHANF_DEFAULT, 1.0);
					PB_DynamicTail("shotgun", "shotgun");
					//A_FireCustomMissile("GunFireSmoke", 0, 0, 2, 1, 0, 0);
					PB_GunSmoke(-2,0,0); PB_MuzzleFlashEffects(-2,0,0);
					A_FireCustomMissile("YellowFlareSpawn",0,0,3,0);
					A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
					A_Giveinventory("JustFiredAutoshotgun",20);
					A_GunFlash;
					A_ZoomFactor(0.98);
					PB_WeaponRecoil(-2.30,-1.88);
				}
				AG61 B 1 BRIGHT {
					A_FireProjectile("ShotgunWad",random(-2,2),0,random(12,13),-2,FPF_NOAUTOAIM,random(-2,2));
					A_ZoomFactor(0.99);
					PB_WeaponRecoil(-2.30,-1.88);
				}
				AG61 C 1 {
					A_ZoomFactor(1.0);
					PB_SpawnCasing("ShotgunCasing",18,15,24,0,3,3);
				}
				AG61 D 1 {
					if(CountInv("LeftASGAmmo")>0 || CountInv("AutoShotgunAmmo")<=0 ){
						A_TakeInventory("DualFiring",1);
					}
				}
				AG61 EFGH 1
				TNT1 A 0 {
					if(CountInv("AutoShotgunAmmo")<=0){
						A_GiveInventory("DualFireReload",1);
					}
				}
				Goto IdleRight_Overlay
	
		RightMuzzleFlash:
			TNT1 A 0 A_Jump(256, "RightMuzzle1", "RightMuzzle2")
		RightMuzzle1:
			AG64 A 1 BRIGHT
			TNT1 A 0 A_Jump(256, "RightMuzzle3", "RightMuzzle4", "RightMuzzle5")
			Stop
		RightMuzzle2:
			AG64 B 1 BRIGHT
			TNT1 A 0 A_Jump(256, "RightMuzzle3", "RightMuzzle4", "RightMuzzle5")
			Stop
		RightMuzzle3:
			AG64 C 1 BRIGHT
			Stop
		RightMuzzle4:
			AG64 D 1 BRIGHT
			STOP
		RightMuzzle5:
			AG64 E 1 BRIGHT
			STOP
		LeftMuzzleFlash:
			TNT1 A 0 A_Jump(256, "LeftMuzzle1", "LeftMuzzle2")
		LeftMuzzle1:
			AG65 A 1 BRIGHT
			TNT1 A 0 A_Jump(256, "LeftMuzzle3", "LeftMuzzle4", "LeftMuzzle5")
			Stop
		LeftMuzzle2:
			AG65 B 1 BRIGHT
			TNT1 A 0 A_Jump(256, "LeftMuzzle3", "LeftMuzzle4", "LeftMuzzle5")
			Stop
		LeftMuzzle3:
			AG65 C 1 BRIGHT
			Stop
		LeftMuzzle4:
			AG65 D 1 BRIGHT
			STOP
		LeftMuzzle5:
			AG65 E 1 BRIGHT
			STOP
			
		WeaponSpecial:
			TNT1 A 0 {
				A_SetInventory("GoWeaponSpecialAbility",0);
				A_SetInventory("PB_LockScreenTilt",1);
				PB_HandleCrosshair(70);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("PB_Autoshotgun", 2,"SwitchToDualWield")
			TNT1 A 0 A_Print("$PB_ASG_NOAKIMBO")
			Goto Ready3
				
		SwitchToDualWield:
			TNT1 A 0 {
				A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto");
				if (A_CheckAkimbo()) {
					A_SetAkimbo(False);
					return state("SwitchFromDualWield");
				}
				else {
					A_SetAkimbo(True);
					return state("");
				}
				
				}
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag",1,4)
			AG60 ABC 1 A_Setroll(roll-0.5, SPF_INTERPOLATE)
			
			//AG60 ABC 0 A_Setroll(roll-0.5, SPF_INTERPOLATE)
		SwitchToDualWieldContinue:
			AG60 DEFGH 1 A_Setroll(roll-0.5, SPF_INTERPOLATE)
			AG60 IJK 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 LM 1 A_Setroll(roll+1.0, SPF_INTERPOLATE)
			AG60 N 1 A_Setroll(0, SPF_INTERPOLATE)
			Goto ReadyDualWield
		StopDualWield:
		SwitchFromDualWield:
			AG60 NMLKJI 1 A_Setroll(roll-1.0, SPF_INTERPOLATE)
			AG60 HGF 1 A_Setroll(roll+2.0, SPF_INTERPOLATE)
			AG60 ED 1
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag",1,4)
			AG60 CBA 1 
			TNT1 A 0 A_Setroll(0, SPF_INTERPOLATE)
			Goto Ready3
		
		Deselect:
			TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				A_ClearOverlays(10,11);
				A_SetInventory("PB_LockScreenTilt",0);
			}
			TNT1 A 0 A_JumpIf(A_CheckAkimbo(), "DualWieldDeselect")
			TNT1 A 0 A_JumpIf(PB_GetMagUnloaded, 2)
			TNT1 A 0 A_JumpIf(CountInv("AutoshotgunDrumMag")>=1, "DrumDeselect")
			TNT1 A 0 A_SetInventory("Unloading",0)
			TNT1 A 0 A_SetInventory("RandomHeadExploder",0)
			
			AG10 ECBA 1
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		DrumDeselect:
			TNT1 A 0 A_SetInventory("Unloading",0)
			TNT1 A 0 A_SetInventory("RandomHeadExploder",0)
			
			AU24 EFG 0
			AU23 EFG 0
			AU02 EFG 0
			AU01 EFG 0
			AU10 DCBA 1 //{if (CountInv("AutoshotgunDrumMag") == 1 ) { A_SetWeaponSprite("AU10");}}
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		DualWieldDeselect:
			TNT1 A 0 A_SetInventory("Unloading",0)
			TNT1 A 0 A_SetInventory("RandomHeadExploder",0)
			AG60 LKJI 1
			//AG60 NMLKJI 1 
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		Select:
			TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				PB_HandleCrosshair(70);
				A_SetInventory("PB_LockScreenTilt",0);
				A_ClearOverlays(10,11);
			}
			
			Goto SelectFirstPersonLegs
			SelectContinue:
			TNT1 A 0 A_SetInventory("Unloading",0)
			TNT1 A 0 A_SetInventory("RandomHeadExploder",1)
			TNT1 A 0 PB_WeapTokenSwitch("ASGSelected")
			TNT1 A 0 ACS_NamedExecuteAlways("ToggleShotgunUpgraded",0) //For people who want this weapon to replace another
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Raise
			TNT1 AAAAAAAA 1 A_Raise
			Wait
		
		Fire:
			TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				PB_HandleCrosshair(70);
				A_SetInventory("PB_LockScreenTilt",0);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 PB_JumpIfNoAmmo
			TNT1 A 0 PB_FireOffset
			TNT1 A 0 A_JumpIf(A_CheckAkimbo, "FireDualWield")	
			TNT1 A 0 A_JumpIf(CountInv("AutoshotgunDrumMag") == 1 && !PB_GetMagUnloaded, "DrumFire")
			TNT1 A 0 A_JumpIf(PB_GetChamberEmpty && !PB_GetMagUnloaded, "Pump")
			TNT1 A 0 PB_FireBullets("PB_12GAPellet",4,frandom(5.84,6.45),0,0,frandom(5.2,6.75))
			AG20 A 1 BRIGHT {
				PB_IncrementHeat(2);
				//A_FireBullets (frandom(5.85,6.65), frandom(5.32,6.75), 4, 8, "MachineGunBulletPuff");
				//A_FireBullets (frandom(5.85,6.65), frandom(5.32,6.75), 4, 8, "MachineGunBulletPuff");
				PB_FireBullets("PB_12GAPellet_ASG",8,frandom(5.85,6.65),0,0,frandom(5.32,6.75));
				A_FireProjectile("ShotgunWad",random(-1,1),0,random(-1,1),-1,FPF_NOAUTOAIM,random(-1,1)); //Keeping the shotgun wad projectile
				PB_LowAmmoSoundWarning("shotgun");
				PB_TakeAmmo("AutoShotgunAmmo",1,0);
				A_AlertMonsters;
				A_StartSound("Weapons/AutoShotgun", CHAN_Weapon, CHANF_DEFAULT, 1.0);
				PB_DynamicTail("shotgun", "shotgun");
				//A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				PB_GunSmoke(0,0,0); PB_MuzzleFlashEffects(0,0,0);
				A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
				A_FireCustomMissile("YellowFlareSpawn",0,0,0,0);
				A_Giveinventory("JustFiredAutoshotgun",20);
				A_GunFlash;
				A_ZoomFactor(0.98);
				PB_WeaponRecoil(-1.64,+0.88);
			}
			AG20 B 1 BRIGHT {
				
				A_ZoomFactor(0.99);
				PB_WeaponRecoil(-1.64,+0.88);
			}
			AG20 C 1 {
				A_ZoomFactor(1.0);
				PB_SpawnCasing("ShotgunCasing",25,3,27,0,3,3);
			}
			AG20 DEFGH 1 A_DoPBWeaponAction(WRF_NOFIRE|WRF_NOBOB)
			AG20 I 1 PB_ReFire
			Goto Ready3
		
