			AG60 N 1
			Goto Ready3	

	}
}
ACTOR AutoShotgunAmmo : Ammo{
	Inventory.MaxAmount 12
	+INVENTORY.IGNORESKILL
	Inventory.Icon "AUSCA0"
}
ACTOR LeftASGAmmo : Ammo{
	Inventory.MaxAmount 12
	+INVENTORY.IGNORESKILL
	Inventory.Icon "AUSCA0"
}
ACTOR FlakTrail{
	RenderStyle Add
	Scale 0.016
	Alpha 0.65
	+NOINTERACTION
	+NOGRAVITY
	+BRIGHT
	States{
		Spawn:
			YAE4 A 0 NoDelay A_JumpIf(ScaleX <= 0, "NULL")
			YA36 C 1 {
				A_SetScale(ScaleX-0.002);
				A_FadeOut(0.05);
			}
			Loop
	}
}
ACTOR ASGFlakChunk{
	Radius 3
	Height 4
	Speed 45
	Damage 8
	Mass 200
	Scale 0.4
	+MISSILE
	+DOOMBOUNCE
	+BLOODSPLATTER
	+ROLLSPRITE
	+BRIGHT
	BounceFactor 0.65
	SeeSound "weapons/smcasebounce"
	BounceSound "weapons/smcasebounce"
	MissileType "FlakTrail"
	States{
		Spawn:
			"----" A 0 NoDelay A_ScaleVelocity(frandom(0.8,1.2))
		Fly:
			"----" A 1 Bright {
				A_CustomMissile("YellowFlareSpawn", 0, 0, 0, 0);
				A_SpawnItemEx("FlakTrail",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0);
				A_SetRoll(Roll+45);
			}
			loop
		Death:
			EXPL AAA 0 A_CustomMissile ("ExplosionSmokeSmall22", 4, 0, random (0, 360), 2, random (0, 360))
			Stop
	}
}
ACTOR Chunk1 : ASGFlakChunk{
	Damagetype "Cutless"
	States{
		Spawn:
			FLAS A 0 NODELAY
			goto Super::Spawn
	}
}
ACTOR Chunk2 : ASGFlakChunk{
	Damagetype "Saw"
	States{
		Spawn:
			FLAS B 0 NODELAY
			goto Super::Spawn
	}
}
ACTOR Chunk3 : ASGFlakChunk{
	Damagetype "Blast"
	States{
		Spawn:
			FLAS C 0 NODELAY
			goto Super::Spawn
	}
}
ACTOR Chunk4 : ASGFlakChunk{
	Damagetype "Shotgun"
	States{
		Spawn:
			FLAS D 0 NODELAY
			goto Super::Spawn
	}
}
