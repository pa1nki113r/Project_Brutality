		Pump:
			TNT1 A 0 A_JumpIfInventory("AutoshotgunDrumMag", 1, "DrumPump")
			TNT1 A 0 {
				A_SetInventory("PB_LockScreenTilt",1);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				
				if (CountInv("JustFiredAutoshotgun") >= 60) {
						A_Overlay(999,"BarrelSmoke2");
				}
			}
			AG40 ABCDEFGH 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
			TNT1 A 0 {
				A_PlaysoundEx("H4SGCOCK", "Auto");
				if(!PB_GetMagEmpty) {PB_SetChamberEmpty(false);}
				A_SetInventory("ASGSpent",0);
			}
			AG40 IJ 1 A_SetRoll(roll-0.3,SPF_INTERPOLATE)
			TNT1 A 0 PB_SpawnCasing("ShotgunCasing",15,-8,27,0,3,3)
			AG40 KL 1 A_SetRoll(roll-0.3,SPF_INTERPOLATE)
			TNT1 A 0 A_JumpIf(A_CheckAkimbo(),"RightReloadFinished")
			AG40 MNI 1 A_SetRoll(roll+0.4,SPF_INTERPOLATE)
			AG40 HGFEDCBA 1 A_SetRoll(roll+0.1,SPF_INTERPOLATE)
			TNT1 A 0 PB_ReFire
			Goto Ready3
			
