ACTOR PB_CrueltyHPBonus : PB_DemonHPBonus
{
	RenderStyle "Add"
	Inventory.Amount 1
	Height 16
	Radius 32
	Scale 0.4
	+FLOATBOB
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		BON3 ABCB 3 BRIGHT
		Loop
	}
}

ACTOR PB_CrueltyAPBonus : PB_DemonAPBonus
{
	RenderStyle "Add"
	Armor.SaveAmount 1
	Height 16
	Radius 32
	Scale 0.4
	+FLOATBOB
	+FORCEXYBILLBOARD
	States
	{
	Spawn:
		BON4 ABCB 3 BRIGHT
		Loop
	}
}

ACTOR CrueltyBonus5health : SwitchableDecoration //23167
{
	Game Doom
	Radius 2
	Height 2
	+NOCLIP
	+NOINTERACTION
	+THRUACTORS
	+THRUSPECIES
	+NOBLOCKMAP
	States
	{
	Spawn:
		TNT1 A 0 NoDelay
		TNT1 AAAAA 2 A_SpawnItemEx("PB_CrueltyHPBonus",0,0,0,frandom(-3,3),frandom(-3,3),frandom(5,15),random(0,360),SXF_NOCHECKPOSITION)
		Stop
	}
}

